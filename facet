# ── Setup ────────────────────────────────────────────────────

# Always part of frameshell; the rest is asked in the setup
CORE_PACKAGES=(ghostty fish starship fastfetch quickshell tui hypr wallpaper gtk)
# The apps of the setup's checklist: modules, and claude for Claude Code
OPTIONAL_APPS=(
  "spotify|Spotify, themed, with search and controls in the launcher"
  "discord|Vesktop (Discord), themed, with calls and DMs in the shell"
  "steam|Steam with Millennium, themed, its notifications in the shell"
  "zed|Zed, the code editor"
  "dolphin|Dolphin, the file manager"
  "zen|Zen, the browser"
  "claude|Claude Code, the claude command; the launcher's c asks it"
)
LAYOUT_STATE="$STATE_DIR/layout"

# Filled by setup_wizard, used by cmd_install
SETUP_PKGS=()
WANT_CLAUDE=0
WANT_GOXLR=0
# Virtual sound channels (facet audio channels on), only when asked for
WANT_CHANNELS=0
PICKED_LAYOUT=""

# TC-Helicon GoXLR (1220:8fe0) or GoXLR Mini (1220:8fe4) on USB
goxlr_connected() {
  local d
  for d in /sys/bus/usb/devices/*; do
    [[ -r $d/idVendor && -r $d/idProduct ]] || continue
    [[ $(<"$d/idVendor") == 1220 && $(<"$d/idProduct") == 8fe[04] ]] && return 0
  done
  return 1
}

current_layout() {
  local mode=tiling
  [[ -f $LAYOUT_STATE ]] && read -r mode <"$LAYOUT_STATE"
  [[ $mode == canvas ]] && echo canvas || echo tiling
}

save_layout() {
  run mkdir -p "$STATE_DIR"
  if ((DRY_RUN)); then
    info "would write $1 to $LAYOUT_STATE"
  else
    echo "$1" >"$LAYOUT_STATE"
  fi
}

# facet install without packages: the desktop first, the apps are a separate choice so
# only the modules that are wanted get downloaded
setup_wizard() {
  local mode picked app apps=() all=""
  mode=$(choose "What should be set up?" \
    "full|the full desktop: bar, launcher, lockscreen, Hyprland, wallpapers, terminal and prompt" \
    "shell|only the shell, without the terminal look (Ghostty, fish, Starship, fastfetch)")
  if [[ $mode == shell ]]; then
    mapfile -t SETUP_PKGS < <(expand_targets shell)
  else
    SETUP_PKGS=("${CORE_PACKAGES[@]}")
  fi

  for app in "${OPTIONAL_APPS[@]}"; do
    [[ ${app%%|*} == claude ]] && command -v claude >/dev/null && continue
    apps+=("$app")
    all+=" ${app%%|*}"
  done
  # Nothing ticked to start with; -y takes every app, as it always did
  picked=$(checklist "Which apps? (more any time: facet add)" "$( ((ASSUME_YES)) && echo "$all")" "${apps[@]}") \
    || { info "Cancelled, nothing changed"; exit 0; }
  for app in $picked; do
    if [[ $app == claude ]]; then
      WANT_CLAUDE=1
    else
      mapfile -t -O "${#SETUP_PKGS[@]}" SETUP_PKGS < <(module_packages "$app")
    fi
  done
  picked=${picked//$'\n'/ }
  ok "Apps: ${picked:-none}"

  # A connected GoXLR needs its utility for the faders and mutes in the shell
  if goxlr_connected && ! command -v goxlr-daemon >/dev/null; then
    ok "GoXLR found, GoXLR Utility will be installed"
    WANT_GOXLR=1
  fi

  # Without a GoXLR: its channels as virtual outputs, only when picked (-y says no)
  if ! goxlr_connected && [[ ! -f $CHANNELS_STATE ]]; then
    local channels
    channels=$(choose "Sound channels like a GoXLR? (any time: facet audio channels on|off)" \
      "no|one output; the mixer moves apps between your sound devices" \
      "yes|virtual System, Game, Chat and Music outputs: a fader each, a track each in recordings")
    [[ $channels == yes ]] && WANT_CHANNELS=1
  fi

  # A connected keyboard that frame-keyboard knows gets it and the keyboard app
  if keyboard_connected; then
    ok "A supported keyboard is plugged in, the keyboard package comes along"
    SETUP_PKGS+=(keyboard)
  fi

  if [[ ! -f $LAYOUT_STATE ]]; then
    PICKED_LAYOUT=$(choose "Window layout? (switch any time: facet layout tiling|canvas)" \
      "tiling|Hyprland's tiling with workspaces, as usual" \
      "canvas|infinite canvas: windows float on an endless plane, the bar shows a minimap")
  fi
}

# Anthropic's own installer puts claude into ~/.local/bin and keeps it updated
install_claude() {
  step "Claude Code"
  if command -v claude >/dev/null; then
    ok "claude already installed"
    return 0
  fi
  if task "Installing Claude Code" "" bash -c 'curl -fsSL https://claude.ai/install.sh | bash'; then
    ok "Claude Code installed; run claude once to sign in, then the launcher's c works"
  else
    warn "Claude Code install failed; try again with: curl -fsSL https://claude.ai/install.sh | bash"
  fi
}

# The package came with the dependencies; start the daemon now, Hyprland starts it from then on
setup_goxlr() {
  step "GoXLR"
  if ! command -v goxlr-daemon >/dev/null && ((!DRY_RUN)); then
    warn "goxlr-daemon not found after the install; the shell's GoXLR panel stays empty"
    return 0
  fi
  if command -v pgrep >/dev/null && pgrep -x goxlr-daemon >/dev/null; then
    ok "GoXLR Utility is running"
  elif ((DRY_RUN)); then
    info "would start goxlr-daemon"
  else
    (goxlr-daemon >/dev/null 2>&1 &)
    ok "GoXLR Utility started (settings: http://localhost:14564)"
  fi
  info "Unplug and replug the GoXLR once if it does not show up (new udev rules)"
}

# facet layout [tiling|canvas]: switch between Hyprland's tiling and the infinite canvas
cmd_layout() {
  local want=${1:-} now
  now=$(current_layout)
  if [[ -z $want ]]; then
    info "Layout: $now (facet layout tiling|canvas)"
    return 0
  fi
  [[ $want == tiling || $want == canvas ]] || die "Unknown layout: $want" "$(did_you_mean "$want" tiling canvas)facet layout tiling or canvas"
  if [[ $want == "$now" ]]; then
    ok "Already $now"
    return 0
  fi
  # Leaving the canvas: big windows tile again before the canvas code is gone
  if [[ $now == canvas ]] && command -v hyprctl >/dev/null; then
    run_quiet hyprctl eval 'frame_canvas.release()' || true
  fi
  save_layout "$want"
  if command -v hyprctl >/dev/null; then
    run_quiet hyprctl reload || true
  fi
  ok "Layout: $want"
  [[ $want == canvas ]] && info "Super+Ctrl+arrows looks around, Super+Alt+arrows jumps between windows, hold Super for all keys"
  return 0
}

# The styles there are: every module called style-<name>
style_names() {
  local m
  for m in "${MODULES[@]}"; do [[ $m == style-* ]] && echo "${m#style-}"; done
  return 0
}

# facet style [list|set|<name>]: the look of the whole desktop (bar, panels, popups, login
# and boot screens); facet theme is its colors. The old style's packages are unlinked, the
# new one's linked into the same folders, the theme written for it, the shell restarted.
cmd_style() {
  local want=${1:-} now names=() p pkgs=()
  now=$(current_style)
  mapfile -t names < <(style_names)
  if [[ $want == set ]]; then
    local opts=() n start=0 i=0
    for n in "${names[@]}"; do
      [[ $n == "$now" ]] && start=$i
      opts+=("$n|${MODULE_DESC[style-$n]:-}")
      i=$((i + 1))
    done
    want=$(menu "Which style? (now: $now)" "$start" "${opts[@]}") || exit 0
  fi
  if [[ -z $want || $want == list ]]; then
    for n in "${names[@]}"; do
      if [[ $n == "$now" ]]; then ok "$n (in use)"; else info "$n"; fi
    done
    info "Switch with: facet style <name>; the colors stay (facet theme)"
    return 0
  fi
  [[ " ${names[*]} " == *" $want "* ]] || die "Unknown style: $want" "$(did_you_mean "$want" "${names[@]}")facet style list shows them"
  if [[ $want == "$now" ]]; then
    ok "Already $now"
    return 0
  fi
  need_arch
  header
  ensure_module "style-$want"
  mapfile -t pkgs < <(module_packages "style-$want")
  step "Backup"
  snapshot_pkgs style "${pkgs[@]}"
  step "Style $want"
  # The old style's bar and panels go first; both link into ~/.config/quickshell
  for p in $(module_packages "style-$now"); do
    [[ $(link_state "$p") == missing ]] || stow_pkg -D "$p"
  done
  run mkdir -p "$STATE_DIR"
  if ((DRY_RUN)); then info "would write $want to $STYLE_STATE"; else echo "$want" >"$STYLE_STATE"; fi
  theme_render "$(current_theme)" 0 quiet
  for p in "${pkgs[@]}"; do
    link_pkg "$p" "$LAST_BACKUP"
    run_post "$p"
  done
  select_style_apps
  # A new shell.qml means a new shell; the watchdog restarts it cleanly
  if [[ -x $HOME/.local/bin/frame-shell-watchdog ]]; then
    run_quiet "$HOME/.local/bin/frame-shell-watchdog" restart || true
  fi
  ok "Style: $want"
  info "The login and boot screens follow with: facet login and facet boot (sudo)"
}

# Package and module names as packages: "spotify" is the spicetify package, "shell" all of
# quickshell, hypr, wallpaper and gtk
expand_targets() {
  local a
  for a in "$@"; do
    # "shell" is still the whole desktop: core and the style in use
    if [[ $a == shell ]]; then module_packages core; module_packages "style-$(current_style)"
    elif is_module "$a"; then module_packages "$a"
    else echo "$a"; fi
  done | awk '!seen[$0]++'
}

# The modules these packages live in, each once
modules_of() {
  local p
  for p in "$@"; do echo "${MODULE_OF[$p]}"; done | awk '!seen[$0]++'
}

cmd_install() {
  need_arch
  local pkgs=() p m extra=()
  # An install from before facet: shell becomes core and style-tui first (linked again
  # with the rest by facet update)
  migrate_shell_module >/dev/null
  mapfile -t pkgs < <(expand_targets "$@")

  # Another style's bar and panels would land on top of the ones in use (both link into
  # ~/.config/quickshell): that style is only fetched here, facet style <name> switches
  local keep=() others=()
  for p in "${pkgs[@]}"; do
    m=${MODULE_OF[$p]:-}
    if [[ $m == style-* && $p == "${m#style-}" && $m != "style-$(current_style)" ]]; then
      others+=("$m")
    else
      keep+=("$p")
    fi
  done
  if ((${#others[@]})); then
    pkgs=("${keep[@]}")
    for m in "${others[@]}"; do
      ensure_module "$m"
      info "The ${m#style-} style is there; switch to it with: facet style ${m#style-}"
    done
    ((${#pkgs[@]})) || return 0
  fi

  header
  if ((${#pkgs[@]} == 0)); then
    setup_wizard
    pkgs=("${SETUP_PKGS[@]}")
  fi
  # Modules, Dependencies, Theme, one per package, Claude Code, GoXLR, frame command, channels
  steps_total $((4 + ${#pkgs[@]} + WANT_CLAUDE + WANT_GOXLR + WANT_CHANNELS))
  # Only the modules that are picked get cloned
  command -v git >/dev/null || install_deps git
  step "Modules"
  while IFS= read -r m; do
    if has_module "$m"; then ok "$m is there"; else ensure_module "$m"; fi
  done < <(modules_of "${pkgs[@]}")
  # spicetify themes a Spotify that has to be there; the AUR one lives in /opt/spotify
  if [[ " ${pkgs[*]} " == *" spicetify "* ]] && ! command -v spotify >/dev/null && ! command -v spotify-launcher >/dev/null; then
    extra+=(spotify)
  fi
  ((WANT_GOXLR)) && extra+=(goxlr-utility)

  info "Packages: ${pkgs[*]}"
  ((${#extra[@]})) && info "Apps: ${extra[*]}"
  ((WANT_CLAUDE)) && info "Claude Code: yes"
  [[ -n $PICKED_LAYOUT ]] && info "Layout: $PICKED_LAYOUT"
  ((DRY_RUN)) && info "Dry run, nothing will be changed"
  confirm "Install and link these?" || exit 0

  step "Dependencies"
  mapfile -t deps < <(deps_of "${pkgs[@]}")
  local optional=()
  mapfile -t optional < <(optional_deps_of "${pkgs[@]}")
  install_deps stow jq "${deps[@]}" "${extra[@]}" "${optional[@]}"
  [[ -n $PICKED_LAYOUT ]] && save_layout "$PICKED_LAYOUT"

  # The color files are generated, so they exist before anything is linked
  step "Theme"
  if [[ ! -f $(theme_state) ]]; then
    local picked choices=()
    mapfile -t choices < <(theme_choices)
    theme_previews
    picked=$(choose "Which theme? (switch any time: facet theme set <name>)" "${choices[@]}")
    save_theme "$picked"
  fi
  theme_render "$(current_theme)" 0 quiet

  local backup
  backup="$(new_backup_dir install)"
  for p in "${pkgs[@]}"; do
    step "$p"
    link_pkg "$p" "$backup"
    run_post "$p"
  done

  ((WANT_CLAUDE)) && install_claude
  ((WANT_GOXLR)) && setup_goxlr

  step "facet command"
  link_self
  # Last: it restarts PipeWire (and a running shell); a problem only warns
  if ((WANT_CHANNELS)); then
    (setup_channels) || warn "The sound channels were not set up; try again with: facet audio channels on"
  fi
  [[ -d $backup ]] && info "Old configs were moved to $backup"
  printf '\n%sDone.%s Open a new terminal to see the changes.\n\n' "$c_ok" "$c_reset"
}

# An installed GRUB theme is refreshed by a plain facet update
grub_refresh_wanted() { [[ -d $GRUB_THEME_DIR ]] && command -v grub-mkconfig >/dev/null; }

cmd_update() {
  need_arch
  local requested=("$@") pkgs=("$@") moved=() p
  # An install from before facet: shell becomes core and style-tui first
  mapfile -t moved < <(migrate_shell_module)
  # Core without a style shows nothing; a move whose clone failed gets it here (or says why)
  if has_module core && ! has_module style-tui; then ensure_module style-tui; fi
  ((${#pkgs[@]})) || mapfile -t pkgs < <(installed_packages)
  if ((${#requested[@]} == 0)); then
    for p in "${moved[@]}"; do [[ " ${pkgs[*]} " == *" $p "* ]] || pkgs+=("$p"); done
    # core and the style in use are never optional: a move whose update stopped half way left
    # them without links, and installed_packages only sees linked packages
    local m
    for m in core "style-$(current_style)"; do
      has_module "$m" || continue
      while IFS= read -r p; do
        [[ " ${pkgs[*]} " == *" $p "* ]] || pkgs+=("$p")
      done < <(module_packages "$m")
    done
  fi
  ((${#pkgs[@]})) || die "Nothing installed yet" "start with: facet install"

  header
  # Modules and frame (unless pulled already), Backup, Theme, Dependencies, one per
  # package, and on a plain update GRUB's four and the boot splash. After the CLI
  # restarted itself it goes on counting from where the old version stopped.
  local grub=0 boot=0
  ((${#requested[@]} == 0)) && grub_refresh_wanted && grub=4
  ((${#requested[@]} == 0)) && [[ -d $PLYMOUTH_DIR ]] && boot=1
  # GRUB and the splash need sudo; without a terminal to ask for the password (curl … | bash
  # from a script, an IDE) they would stop the whole update half way, so they wait for the next one
  if ((grub || boot)) && ((!DRY_RUN)) && ! sudo_possible; then
    warn "sudo cannot ask for a password here; GRUB and the boot splash are left for: facet update (in a terminal)"
    grub=0 boot=0
  fi
  if ((NO_PULL)); then
    STEP_N=${FACET_STEPS_DONE:-0}
    steps_total $((STEP_N + 3 + ${#pkgs[@]} + grub + boot))
  else
    steps_total $((5 + ${#pkgs[@]} + grub + boot))
  fi

  if ((!NO_PULL)); then
    # The modules first: the CLI below may restart itself with --no-pull
    step "Modules"
    local m mod_before
    while IFS= read -r m; do
      if [[ -n $(git -C "$(module_dir "$m")" status --porcelain --untracked-files=no) ]]; then
        warn "$m has local changes, left as it is ($(module_dir "$m"))"
        continue
      fi
      mod_before=$(git -C "$(module_dir "$m")" rev-parse --short HEAD)
      if task "Updating $m" "" git -C "$(module_dir "$m")" pull --ff-only --quiet; then
        [[ $(git -C "$(module_dir "$m")" rev-parse --short HEAD) == "$mod_before" ]] \
          && ok "$m up to date" || ok "$m updated"
      else
        warn "Could not update $m"
      fi
    done < <(installed_modules)

    step "facet"
    [[ -z $(git -C "$REPO" status --porcelain --untracked-files=no) ]] \
      || die "The CLI has local changes, so it cannot pull" "keep them aside: git -C $REPO stash, then facet update again (or commit them)"
    local before after
    before=$(git -C "$REPO" rev-parse HEAD)
    task "Updating facet" "" git -C "$REPO" pull --ff-only --quiet \
      || die "Could not update facet" "check the internet connection, then facet update again"
    after=$(git -C "$REPO" rev-parse HEAD)
    if [[ $before == "$after" ]]; then
      ok "Already up to date"
    else
      ok "Updated $(git -C "$REPO" rev-parse --short "$before") → $(git -C "$REPO" rev-parse --short "$after")"
      # Continue with the freshly pulled version of this script
      local flags=(--no-pull)
      ((ASSUME_YES)) && flags+=(-y)
      ((VERBOSE)) && flags+=(-v)
      export FACET_STEPS_DONE=$STEP_N
      exec "$REPO/facet" update "${flags[@]}" "${requested[@]}"
    fi
  fi

  # The command first, so a step that fails below never leaves a dangling frame and no facet
  link_self

  step "Backup"
  snapshot_pkgs update "${pkgs[@]}"

  # Templates may have changed with the pull
  step "Theme"
  prune_old_outputs
  theme_render "$(current_theme)" 0 quiet

  step "Dependencies"
  mapfile -t deps < <(deps_of "${pkgs[@]}")
  install_deps "${deps[@]}"

  local p
  for p in "${pkgs[@]}"; do
    step "$p"
    link_pkg "$p" "$LAST_BACKUP"
    run_post "$p"
  done

  # A plain `facet update` also refreshes an installed GRUB theme
  ((grub)) && grub_apply
  # The splash lives in /usr/share and the initramfs, so a newer template or theme
  # only reaches it when it is installed again
  if ((boot)); then
    step "Boot splash"
    if boot_splash_outdated; then
      info "The splash changed with this update; installing it again (sudo, rebuilds the initramfs)"
      boot_splash_install
    else
      ok "Boot splash up to date"
    fi
  fi
  printf '\n%sDone.%s\n\n' "$c_ok" "$c_reset"
}

# pick_modules <add|remove>: the modules ticked in a checklist, for facet add and frame
# remove without names; add offers the ones not downloaded yet, remove the installed ones.
# Prints nothing when there is nothing to do (the reason goes to stderr).
pick_modules() {
  local action=$1 m opts=() names=() picked what=installed
  [[ $action == add ]] && what="not installed yet"
  for m in "${MODULES[@]}"; do
    if [[ $action == add ]]; then has_module "$m" && continue; else has_module "$m" || continue; fi
    opts+=("$m|${MODULE_DESC[$m]}")
    names+=("$m")
  done
  if ((${#opts[@]} == 0)); then
    [[ $action == add ]] && ok "Every module is installed already" >&2 || info "No modules installed" >&2
    return 0
  fi
  interactive && ((!ASSUME_YES)) \
    || die "Which module?" "name it: facet $action ${names[0]} · $what: ${names[*]}"
  picked=$(checklist "Which modules? ($what)" "" "${opts[@]}") \
    || { info "Cancelled, nothing changed" >&2; return 0; }
  [[ -n $picked ]] || info "Nothing ticked, nothing changed" >&2
  echo "$picked"
}

cmd_remove() {
  if (($# == 0)); then
    local picked
    header
    picked=$(pick_modules remove) || exit
    [[ -n $picked ]] || exit 0
    set -- $picked
  fi
  command -v stow >/dev/null || ((DRY_RUN)) || die "stow is not installed" "install it: sudo pacman -S stow"
  local p m pkgs=()
  mapfile -t pkgs < <(expand_targets "$@")
  for p in "${pkgs[@]}"; do
    step "$p"
    if [[ -z $(pkg_root "$p") ]] || ! has_module "${MODULE_OF[$p]}"; then
      info "Nothing linked"
      continue
    fi
    stow_pkg -D "$p"
    ok "Config unlinked"
  done
  # A module with nothing linked any more can go entirely, which is what saves the space
  while IFS= read -r m; do
    has_module "$m" || continue
    local still=0
    for p in $(module_packages "$m"); do
      [[ $(link_state "$p") == missing ]] || still=1
    done
    ((still)) && continue
    if confirm "Delete the $m module too ($(human_bytes "$(dir_bytes "$(module_dir "$m")")"), facet add $m brings it back)?"; then
      run rm -rf "$(module_dir "$m")"
      ok "Module $m deleted"
    fi
  done < <(modules_of "${pkgs[@]}")
  info "Backups of your old configs: facet restore"
}

cmd_backup() {
  local pkgs=("$@")
  ((${#pkgs[@]})) || pkgs=("${PACKAGES[@]}")
  header
  step "Backup"
  snapshot_pkgs manual "${pkgs[@]}"
  [[ -n $LAST_BACKUP && -d $LAST_BACKUP ]] && info "$LAST_BACKUP"
  return 0
}

cmd_restore() {
  local name=${1:-} b
  header

  if [[ -z $name ]]; then
    step "Backups"
    local found=0 count
    while IFS= read -r b; do
      found=1
      count=$(find "$BACKUP_ROOT/$b" -type f | wc -l)
      printf '  %-34s %s%s files%s\n' "$b" "$c_muted" "${count// /}" "$c_reset"
    done < <(list_backups)
    if ((found)); then
      info "Put one back with: facet restore <name>   (or: facet restore latest)"
    else
      info "No backups yet. Create one with: facet backup"
    fi
    return 0
  fi

  [[ $name == latest ]] && name=$(list_backups | head -n 1)
  local src="$BACKUP_ROOT/$name"
  [[ -n $name && -d $src ]] || die "No backup named ${1}" "list them: facet restore"

  local files=() f
  while IFS= read -r f; do files+=("$f"); done < <(cd "$src" && find . -type f | sed 's|^\./||' | sort)
  ((${#files[@]})) || die "Backup $name is empty" "pick another one: facet restore"

  step "Restore $name"
  for f in "${files[@]}"; do info "~/$f"; done
  confirm "Put these ${#files[@]} files back? The current state is backed up first." || exit 0

  step "Safety backup"
  snapshot_files before-restore "${files[@]}"

  step "Restoring"
  for f in "${files[@]}"; do
    run mkdir -p "$HOME/$(dirname "$f")"
    # Drop frame's symlink first so the copy does not land in the repo
    [[ -L $HOME/$f ]] && run rm "$HOME/$f"
    run cp "$src/$f" "$HOME/$f"
  done
  ok "Restored $name"
  info "Restored files are plain copies. To link a package again: facet install <package>"
}

# ── Clean ────────────────────────────────────────────────────
# Packages frameshell needed once and does not any more (its own code does the job now);
# facet clean offers them for removal when nothing else depends on them
RETIRED_PACKAGES=(ttf-jetbrains-mono-nerd hypridle swaybg cliphist fd wtype unicode-emoji sound-theme-freedesktop pacman-contrib)
FREED=0

dir_bytes() {
  du -sb "$@" 2>/dev/null | awk '{ s += $1 } END { print s + 0 }'
}

human_bytes() {
  numfmt --to=iec --suffix=B "$1" 2>/dev/null || echo "$1 bytes"
}

# Installed size of packages, from pacman's "Installed Size : 12.34 MiB"
pkg_bytes() {
  (($#)) || { echo 0; return; }
  LC_ALL=C pacman -Qi "$@" 2>/dev/null | awk -F': *' '
    /^Installed Size/ {
      split($2, p, " "); n = p[1]; u = p[2]
      f = (u == "KiB") ? 1024 : (u == "MiB") ? 1048576 : (u == "GiB") ? 1073741824 : 1
      s += n * f
    }
    END { printf "%d\n", s }'
}

# clean_item <label> <bytes> <command…>: asks with the size, runs it, counts what it freed
clean_item() {
  local label=$1 bytes=$2
  shift 2
  ((bytes > 0)) || return 0
  if confirm "$label ($(human_bytes "$bytes"))?"; then
    run "$@" && FREED=$((FREED + bytes))
  fi
  return 0
}

# facet clean: shows what takes space for nothing and frees it, one question per item
cmd_clean() {
  need_arch
  header
  FREED=0

  step "Package caches"
  local cache=/var/cache/pacman/pkg
  # pacman keeps every version it ever downloaded; -Sc keeps the installed ones
  [[ -d $cache ]] && clean_item "pacman cache, the installed versions stay; up to" "$(dir_bytes "$cache")" sudo pacman -Sc --noconfirm
  local d
  for d in "$HOME/.cache/paru" "$HOME/.cache/yay"; do
    [[ -d $d ]] && clean_item "AUR build cache ${d/#"$HOME"/\~}" "$(dir_bytes "$d")" rm -rf "$d"
  done
  local store="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm/store"
  [[ -d $store ]] && command -v pnpm >/dev/null && clean_item "pnpm store (Vencord build tools); up to" "$(dir_bytes "$store")" pnpm store prune
  [[ -d $VENCORD_SRC/node_modules ]] && clean_item "Vencord build tools (dist/ stays)" "$(dir_bytes "$VENCORD_SRC/node_modules")" rm -rf "$VENCORD_SRC/node_modules"

  step "Packages"
  local orphans=()
  mapfile -t orphans < <(pacman -Qdtq 2>/dev/null || true)
  if ((${#orphans[@]})); then
    info "Installed as dependencies, needed by nothing now: ${orphans[*]}"
    clean_item "Remove these ${#orphans[@]} orphans" "$(pkg_bytes "${orphans[@]}")" sudo pacman -Rns --noconfirm "${orphans[@]}"
  else
    ok "No orphaned packages"
  fi
  local pkg retired=()
  for pkg in "${RETIRED_PACKAGES[@]}"; do
    pacman -Qq "$pkg" &>/dev/null || continue
    [[ $(LC_ALL=C pacman -Qi "$pkg" | awk -F': *' '/^Required By/ { print $2 }') == None ]] || continue
    retired+=("$pkg")
  done
  if ((${#retired[@]})); then
    info "frameshell does its own thing instead of these now: ${retired[*]}"
    info "Keep the ones you use yourself (answer no and remove the others by hand)"
    clean_item "Remove them" "$(pkg_bytes "${retired[@]}")" sudo pacman -Rns --noconfirm "${retired[@]}"
  fi

  step "Logs, thumbnails, backups"
  if [[ -d /var/log/journal ]]; then
    local journal
    journal=$(sudo -n du -sb /var/log/journal 2>/dev/null | awk '{ print $1 }' || true)
    [[ -n $journal ]] || journal=$(dir_bytes /var/log/journal)
    ((journal > 104857600)) && clean_item "System journal down to 100 MB" "$((journal - 104857600))" sudo journalctl --vacuum-size=100M
  fi
  [[ -d $HOME/.cache/thumbnails ]] && clean_item "File manager thumbnails (made again when needed)" "$(dir_bytes "$HOME/.cache/thumbnails")" rm -rf "$HOME/.cache/thumbnails"
  local old=()
  mapfile -t old < <(list_backups | tail -n +4)
  if ((${#old[@]})); then
    local paths=() b
    for b in "${old[@]}"; do paths+=("$BACKUP_ROOT/$b"); done
    clean_item "${#old[@]} older facet backups (the newest 3 stay)" "$(dir_bytes "${paths[@]}")" rm -rf "${paths[@]}"
  fi

  printf '\n%sDone.%s Freed about %s.\n\n' "$c_ok" "$c_reset" "$(human_bytes "$FREED")"
}

cmd_status() {
  header
  printf '  %s%-12s %-10s %s%s\n' "$c_muted" "PACKAGE" "CONFIG" "DEPENDENCIES" "$c_reset"
  local m p state d missing color
  for m in "${MODULES[@]}"; do
    if ! has_module "$m"; then
      printf '  %s%-24s not downloaded (facet add %s)%s\n' "$c_muted" "$m" "$m" "$c_reset"
      continue
    fi
    printf '  %s%s%s%s %s%s%s\n' "$c_bold" "$c_primary" "$m" "$c_reset" "$c_muted" "$(git -C "$(module_dir "$m")" log -1 --format='%h %cr' 2>/dev/null)" "$c_reset"
    while IFS= read -r p; do
      state=$(link_state "$p")
      missing=()
      for d in ${DEPS[$p]}; do has_pkg "$d" || missing+=("$d"); done
      case $state in
        linked) color=$c_ok ;;
        partial) color=$c_warn ;;
        *) color=$c_muted ;;
      esac
      if ((${#missing[@]})); then
        printf '    %-10s %s%-10s%s %smissing: %s%s\n' "$p" "$color" "$state" "$c_reset" "$c_danger" "${missing[*]}" "$c_reset"
      else
        printf '    %-10s %s%-10s%s %sok%s\n' "$p" "$color" "$state" "$c_reset" "$c_ok" "$c_reset"
      fi
    done < <(module_packages "$m")
  done

  step "Checks"
  ok "Theme $(current_theme) (facet theme list)"
  ok "Layout $(current_layout) (facet layout tiling|canvas)"
  if goxlr_connected && ! command -v goxlr-daemon >/dev/null; then
    warn "A GoXLR is connected but GoXLR Utility is missing (paru -S goxlr-utility)"
  fi
  if channels_on_now; then
    ok "Sound channels: $(jq -r '[.channels[].label] | join(", ")' "$CHANNELS_STATE" 2>/dev/null) (facet audio channels status)"
  fi
  if keyboard_connected; then
    if [[ $(link_state keyboard) != linked ]]; then
      warn "A supported keyboard is plugged in but the keyboard package is not installed (facet add keyboard)"
    elif [[ ! -f /etc/udev/rules.d/$KEYBOARD_RULE ]] || [[ -f /etc/udev/rules.d/$KEYBOARD_RULE_OLD ]]       || { command -v python3 >/dev/null && ! cmp -s <(python3 "$(keyboard_tool)" udev 2>/dev/null) "/etc/udev/rules.d/$KEYBOARD_RULE"; }; then
      warn "The keyboard's udev rules are missing or old (facet update keyboard)"
    elif [[ -z $(keyboard_saved) ]]; then
      warn "No keyboard picked (facet keyboard set)"
    else
      ok "Keyboard: $(keyboard_name "$(keyboard_saved)") set up (Super+K)"
    fi
  fi
  command -v pacman >/dev/null || warn "pacman not found, dependency checks are skipped"
  command -v stow >/dev/null && ok "stow installed" || warn "stow missing (facet install takes care of it)"

  if command -v fc-list >/dev/null; then
    [[ -n $(fc-list | grep -iE "jetbrains ?mono") ]] && ok "Font JetBrains Mono installed" \
      || warn "Font JetBrains Mono missing, Spotify, Vesktop and GRUB need it (pacman -S ttf-jetbrains-mono)"
  fi

  if has_pkg millennium || has_pkg millennium-bin; then
    if millennium_hook_missing; then
      warn "Millennium is installed but not hooked into Steam (close Steam, then: facet update steam)"
    else
      ok "Millennium hooked into Steam"
    fi
  fi

  [[ -f $ASSETS_DIR/logo.png ]] && ok "fastfetch logo found" \
    || warn "No fastfetch logo at ${ASSETS_DIR/#$HOME/~}/logo.png"

  command -v spotify >/dev/null || command -v spotify-launcher >/dev/null \
    || warn "Spotify not found, the spicetify theme needs it"

  if grep -qs fastfetch /usr/share/cachyos-fish-config/cachyos-config.fish; then
    warn "CachyOS's fish config runs fastfetch too, you may see it twice"
    info "Fix: remove the cachyos-config line in ~/.config/fish/config.fish, or keep theirs and drop fish_greeting in conf.d/frameshell.fish"
  fi

  [[ :$PATH: == *":$HOME/.local/bin:"* ]] || warn "~/.local/bin is not in PATH, the facet command will not be found"

  if [[ -f /boot/grub/grub.cfg ]]; then
    [[ -d $GRUB_THEME_DIR ]] && ok "GRUB theme installed" || info "GRUB theme not installed (facet grub)"
  fi

  if [[ -d $GREETER_DIR ]]; then
    local greetd_config
    greetd_config=$(greetd_config_path)
    if [[ -r $greetd_config && $(greetd_default_command "$greetd_config") == "$GREETER_DIR/frame-greeter-session" ]]; then
      ok "Login screen: frameshell greeter ($greetd_config)"
    else
      warn "Login screen files are installed, but greetd ($greetd_config) starts something else; run facet login again"
    fi
    greetd_is_display_manager || warn "greetd is not the display manager systemd starts"
  fi
  if [[ -r $(greetd_config_path) ]] && grep -q '^\[initial_session\]' "$(greetd_config_path)"; then
    ok "Boot: no greeter, the session starts on the shell's lockscreen (facet login auto)"
  fi

  local conflicts
  conflicts=$(notification_conflicts | tr '\n' ' ')
  if [[ -n ${conflicts// /} ]]; then
    warn "Other notification daemons active: ${conflicts}(facet install quickshell turns them off)"
  fi

  if [[ -d $VENCORD_SRC/dist ]]; then
    ok "Vencord build with ShellBridge ($(cat "$STATE_DIR/vencord-build" 2>/dev/null || echo "unknown version"))"
  fi

  local backups
  backups=$(list_backups | wc -l)
  info "${backups// /} backups in $BACKUP_ROOT (facet restore)"
  echo
}

# ── Main ─────────────────────────────────────────────────────

main() {
  local cmd="" args=() a
  FACET_ARGS="$*"
  # The first word that is not an option is the command; options go anywhere
  while (($#)); do
    case $1 in
      -n | --dry-run) DRY_RUN=1 ;;
      -y | --yes) ASSUME_YES=1 ;;
      -v | --verbose) VERBOSE=1 ;;
      --no-pull) NO_PULL=1 ;;
      -h | --help) cmd=help ;;
      -*) die "Unknown option: $1" "options: -n/--dry-run, -y/--yes, -v/--verbose (facet help)" ;;
      *) if [[ -z $cmd ]]; then cmd=$1; else args+=("$1"); fi ;;
    esac
    shift
  done

  # No command: the menu in a terminal, the help everywhere else (pipes, scripts)
  if [[ -z $cmd ]]; then
    cmd=help
    if interactive && ((!ASSUME_YES)); then
      local MENU_CMD MENU_ARGS=()
      main_menu
      cmd=$MENU_CMD
      args=("${MENU_ARGS[@]}")
      echo
    fi
  fi

  case $cmd in
    install | i | add | update | up | remove | rm | uninstall | backup)
      for a in "${args[@]}"; do
        is_package "$a" || is_module "$a" \
          || die "Unknown module or package: $a" "$(did_you_mean "$a" "${MODULES[@]}" "${PACKAGES[@]}")modules: ${MODULES[*]}"
      done
      ;;
  esac

  case $cmd in
    install | i) cmd_install "${args[@]}" ;;
    add)
      if ((${#args[@]} == 0)); then
        local picked
        header
        picked=$(pick_modules add) || exit
        [[ -n $picked ]] || exit 0
        mapfile -t args <<<"$picked"
      fi
      cmd_install "${args[@]}"
      ;;
    update | up) cmd_update "${args[@]}" ;;
    remove | rm | uninstall) cmd_remove "${args[@]}" ;;
    backup) cmd_backup "${args[@]}" ;;
    restore) cmd_restore "${args[@]}" ;;
    grub) cmd_grub "${args[@]}" ;;
    goxlr) cmd_goxlr "${args[@]}" ;;
    audio) cmd_audio "${args[@]}" ;;
    login) cmd_login "${args[@]}" ;;
    boot) cmd_boot "${args[@]}" ;;
    theme) cmd_theme "${args[@]}" ;;
    wallpaper | wp) cmd_wallpaper "${args[@]}" ;;
    spotify) cmd_spotify "${args[@]}" ;;
    keyboard | kb) cmd_keyboard "${args[@]}" ;;
    layout) cmd_layout "${args[@]}" ;;
    style) cmd_style "${args[@]}" ;;
    __complete) cmd_complete "${args[@]}" ;;
    status | st | doctor) cmd_status ;;
    clean) cmd_clean ;;
    help) usage ;;
    *)
      a=$(closest "$cmd" "${COMMANDS[@]}")
      die "Unknown command: $cmd" "${a:+did you mean facet $a? }all commands: facet help"
      ;;
  esac
}

