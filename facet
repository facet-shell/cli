    fi
  else
    warn "frame-wallpaper is not linked yet, run: facet install wallpaper"
  fi
  info "Super+W opens the wallpaper app; folders: ~/Pictures/wallpapers and assets/wallpapers"
  info "Change the backend later with: facet wallpaper backend both|mpv|image"
}

# ── Keyboards ────────────────────────────────────────────────
# The keyboard module holds frame-keyboard and a registry with one file per supported board
# (.local/share/frameshell/keyboard/boards/<id>.json). Which board you have is saved in
# $STATE_DIR/keyboard/board: facet add keyboard asks, facet keyboard set changes it.

KEYBOARD_RULE=70-facet-keyboards.rules
# What the rule was called while only the AULA F75 was known; it goes on the next update
KEYBOARD_RULE_OLD=70-frameshell-aula-f75.rules
KEYBOARD_CHOICE="$STATE_DIR/keyboard/board"
# USB ids for the setup before the keyboard module is downloaded; the registry wins once it is there
KEYBOARD_IDS_FALLBACK="258a:010c 3554:fa09 0c45:800a"

keyboard_boards_dir() { echo "$(pkg_dir keyboard)/.local/share/frameshell/keyboard/boards"; }
keyboard_tool() { echo "$(pkg_dir keyboard)/.local/bin/frame-keyboard"; }

# "vid:pid" of every board in the registry, one per line
keyboard_ids() {
  local dir
  dir=$(keyboard_boards_dir)
  # An id a board borrows from another vendor ("udev": false) does not count as that board
  if compgen -G "$dir/*.json" >/dev/null && command -v jq >/dev/null; then
    jq -r '.usb[] | select(.udev != false) | "\(.vid):\(.pid)"' "$dir"/*.json | tr 'A-F' 'a-f'
  else
    printf '%s\n' $KEYBOARD_IDS_FALLBACK
  fi | awk '!seen[$0]++'
}

# "vid:pid" of everything on the USB bus
usb_ids() {
  local d
  for d in /sys/bus/usb/devices/*; do
    [[ -r $d/idVendor && -r $d/idProduct ]] && echo "$(<"$d/idVendor"):$(<"$d/idProduct")"
  done
  return 0
}

# A keyboard from the registry is plugged in
keyboard_connected() {
  local ids id
  ids=" $(keyboard_ids | tr '\n' ' ') "
  while read -r id; do
    [[ $ids == *" $id "* ]] && return 0
  done < <(usb_ids)
  return 1
}

keyboard_saved() {
  local b=""
  if [[ -f $KEYBOARD_CHOICE ]]; then
    read -r b <"$KEYBOARD_CHOICE"
  elif [[ -f /etc/udev/rules.d/$KEYBOARD_RULE_OLD ]]; then
    # Before the board registry frame-keyboard knew only the AULA F75, and its udev rule is still
    # there; the plugged-in guess cannot tell it apart (every g5kb board is 258a:010c)
    b=aula-f75
  fi
  echo "$b"
}

# "id<TAB>vendor<TAB>name<TAB>tested<TAB>usb ids<TAB>aliases" per board, sorted by vendor and name
keyboard_board_rows() {
  local dir
  dir=$(keyboard_boards_dir)
  compgen -G "$dir/*.json" >/dev/null || return 0
  jq -r '[.id, .vendor, .name, (if .tested then "tested" else "untested" end),
          ([.usb[] | select(.udev != false) | "\(.vid):\(.pid)"] | unique | join(" ")), ((.aliases // []) | join(", "))] | @tsv' \
    "$dir"/*.json | sort -t $'\t' -k2,2f -k3,3f
}

# Board ids whose USB id is plugged in
keyboard_detected() {
  local ids id vendor name tested usb aliases u
  ids=" $(usb_ids | tr '\n' ' ') "
  while IFS=$'\t' read -r id vendor name tested usb aliases; do
    for u in $usb; do
      if [[ $ids == *" $u "* ]]; then
        echo "$id"
        break
      fi
    done
  done < <(keyboard_board_rows)
  return 0
}

keyboard_name() {
  local f
  f="$(keyboard_boards_dir)/$1.json"
  if [[ -f $f ]]; then
    sed -n 's/^ *"name": *"\([^"]*\)".*/\1/p' "$f" | head -n 1
  else
    echo "$1"
  fi
}

# search_menu <question> <start index> <id|description>...: like menu, but typing filters the
# list (each typed word has to appear in the id or the description, any case); backspace takes
# a letter back, ↑↓ move, enter picks, esc cancels (exit code 1). An option with the id
# not-listed always stays at the end. At most 12 rows show at a time; the list scrolls.
search_menu() {
  local question=$1 sel=${2:-0}
  shift 2
  local opts=("$@") n=$# query="" key rest i j id desc hay word match top=0 max=12 rows drawn=0 want
  local -a shown=()
  ((n < max)) && max=$n
  rows=$((max + 2))
  want=${opts[sel]%%|*}
  printf '  %s\n' "$question" >&2
  printf '  %stype to search · ↑↓ move · enter pick · esc cancel%s\n' "$c_muted" "$c_reset" >&2
  printf '\e[?25l' >&2
  trap 'printf "\e[?25h\n" >&2; exit 130' INT
  while :; do
    # The options that match every typed word
    shown=()
    for ((i = 0; i < n; i++)); do
      id=${opts[i]%%|*}
      hay=${opts[i],,}
      match=1
      if [[ $id != not-listed ]]; then
        for word in $query; do [[ $hay == *"${word,,}"* ]] || match=0; done
      fi
      ((match)) && shown+=("$i")
    done
    # The preselected option keeps its place until something is typed
    if [[ -n $want ]]; then
      for ((j = 0; j < ${#shown[@]}; j++)); do [[ ${opts[shown[j]]%%|*} == "$want" ]] && sel=$j; done
      want=""
    fi
    ((sel >= ${#shown[@]})) && sel=$((${#shown[@]} - 1))
    ((sel < 0)) && sel=0
    ((sel < top)) && top=$sel
    ((sel >= top + max)) && top=$((sel - max + 1))
    ((drawn)) && printf '\e[%dA' "$rows" >&2
    drawn=1
    printf '\r\e[K  %s›%s %s%s%s▏ %s%d of %d%s\n' "$c_primary" "$c_reset" "$c_bold" "$query" "$c_reset" \
      "$c_muted" "${#shown[@]}" "$n" "$c_reset" >&2
    for ((j = top; j < top + max; j++)); do
      if ((j >= ${#shown[@]})); then
        printf '\r\e[K\n' >&2
        continue
      fi
      i=${shown[j]}
      id=${opts[i]%%|*}
      desc=${opts[i]#*|}
      if ((j == sel)); then
        printf '\r\e[K  %s❯%s %s%-15s%s %s\n' "$c_primary" "$c_reset" "$c_bold" "$id" "$c_reset" "$desc" >&2
      else
        printf '\r\e[K    %s%-15s%s %s\n' "$c_muted" "$id" "$c_reset" "$desc" >&2
      fi
    done
    if ((${#shown[@]} > top + max)); then
      printf '\r\e[K    %s… %d more, type to narrow it down%s\n' "$c_muted" $((${#shown[@]} - top - max)) "$c_reset" >&2
    else
      printf '\r\e[K\n' >&2
    fi
    IFS= read -rsn1 key || key=$'\e'
    case $key in
      "") break ;;
      $'\x7f' | $'\x08') query=${query%?} ;;
      $'\e')
        rest=""
        IFS= read -rsn2 -t 0.05 rest || true
        case $rest in
          "[A") ((sel > 0)) && sel=$((sel - 1)) ;;
          "[B") ((sel < ${#shown[@]} - 1)) && sel=$((sel + 1)) ;;
          "")
            trap - INT
            printf '\e[?25h' >&2
            return 1
            ;;
        esac
        ;;
      [[:print:]])
        query+=$key
        sel=0
        ;;
    esac
  done
  trap - INT
  printf '\e[?25h' >&2
  echo "${opts[shown[sel]]%%|*}"
}

# How to ask for a board that is not in the registry
keyboard_request_hint() {
  info "Ask for your keyboard on the facet board: https://github.com/orgs/facet-shell/projects/1"
  info "(new issue, the Idea form, \"Keyboard support: <model>\"). Put in the model, what lsusb shows with the"
  info "keyboard plugged in (cable and dongle) and a link to the vendor's Windows app."
  info "frame-keyboard sends nothing to a board that is not in the list."
}

# The picker: every supported board, the plugged-in one preselected; prints the picked id, or
# nothing for "not listed". -y takes the saved or plugged-in board (nothing when there is none).
keyboard_pick() {
  local id vendor name tested usb aliases opts=() start=0 i=0 saved mark detected first=""
  saved=$(keyboard_saved)
  detected=" $(keyboard_detected | tr '\n' ' ') "
  while IFS=$'\t' read -r id vendor name tested usb aliases; do
    mark=""
    if [[ $detected == *" $id "* ]]; then
      mark=" $c_ok· plugged in$c_reset"
      [[ -z $first ]] && first=$id && start=$i
    fi
    opts+=("$id|$name $c_muted· $usb · $tested${aliases:+ · $aliases}$c_reset$mark")
    i=$((i + 1))
  done < <(keyboard_board_rows)
  ((${#opts[@]})) || return 0
  # A saved board wins over the first plugged-in one (several boards share 258a:010c)
  if [[ -n $saved ]]; then
    for ((i = 0; i < ${#opts[@]}; i++)); do [[ ${opts[i]%%|*} == "$saved" ]] && start=$i; done
  fi
  if ((ASSUME_YES)); then
    echo "${saved:-$first}"
    return 0
  fi
  if ! interactive; then
    # Numbered list for pipes and logs
    printf '  Which keyboard?\n' >&2
    for ((i = 0; i < ${#opts[@]}; i++)); do
      printf '    %s%d%s %-15s %s\n' "$c_primary" $((i + 1)) "$c_reset" "${opts[i]%%|*}" "${opts[i]#*|}" >&2
    done
    printf '  Number [enter: %s] ' "${opts[start]%%|*}" >&2
    local answer=""
    read -r answer || true
    [[ -t 0 ]] || printf '%s\n' "$answer" >&2
    [[ $answer =~ ^[0-9]+$ ]] && ((answer >= 1 && answer <= ${#opts[@]})) && start=$((answer - 1))
    echo "${opts[start]%%|*}"
    return 0
  fi
  opts+=("not-listed|my keyboard is not here: how to ask for it")
  local question="Which keyboard do you have?"
  (($(wc -w <<<"$detected") > 1)) && question+=" (several boards share the USB id that is plugged in)"
  id=$(search_menu "$question" "$start" "${opts[@]}") || { info "No board picked; facet keyboard set picks one later" >&2; return 0; }
  if [[ $id == not-listed ]]; then
    keyboard_request_hint >&2
    return 0
  fi
  echo "$id"
}

keyboard_save() {
  local id=$1 bin
  bin=$(keyboard_tool)
  if ((DRY_RUN)); then
    info "would save $id as your keyboard ($KEYBOARD_CHOICE)"
    return 0
  fi
  if [[ -f $bin ]] && command -v python3 >/dev/null; then
    python3 "$bin" board "$id" >/dev/null || return 1
  else
    mkdir -p "$(dirname "$KEYBOARD_CHOICE")"
    echo "$id" >"$KEYBOARD_CHOICE"
  fi
  ok "Keyboard: $(keyboard_name "$id") ($id)"
}

# The udev rules come from the registry (frame-keyboard udev) and go to /etc/udev/rules.d only
# when they are missing or changed, so updates ask for sudo once
keyboard_udev() {
  local bin tmp dest="/etc/udev/rules.d/$KEYBOARD_RULE"
  bin=$(keyboard_tool)
  if ! command -v python3 >/dev/null || [[ ! -f $bin ]]; then
    if ((DRY_RUN)); then
      info "would write the udev rules for the keyboards to $dest"
    else
      warn "python3 or frame-keyboard missing, no udev rules (facet update keyboard)"
    fi
    return 0
  fi
  tmp=$(mktemp)
  # An older keyboard module has no udev command; its rule stays until facet update keyboard
  if ! python3 "$bin" udev >"$tmp" 2>/dev/null || ! grep -q '^KERNEL==' "$tmp"; then
    rm -f "$tmp"
    warn "frame-keyboard could not list the udev rules; run: facet update keyboard"
    return 0
  fi
  if cmp -s "$tmp" "$dest" && [[ ! -f /etc/udev/rules.d/$KEYBOARD_RULE_OLD ]]; then
    ok "udev rules in place ($dest)"
  else
    info "frame-keyboard needs udev rules to reach the keyboard without root (sudo)"
    if run sudo install -m 644 "$tmp" "$dest"; then
      [[ -f /etc/udev/rules.d/$KEYBOARD_RULE_OLD ]] && run sudo rm -f "/etc/udev/rules.d/$KEYBOARD_RULE_OLD"
      run_quiet sudo udevadm control --reload-rules || true
      run_quiet sudo udevadm trigger --subsystem-match=hidraw || true
      ok "udev rules installed; unplug and replug the keyboard once"
    else
      warn "Could not install the udev rules; by hand: python3 $bin udev | sudo tee $dest"
    fi
  fi
  rm -f "$tmp"
}

# udev rules, then which board you have (asked once; facet keyboard set changes it)
post_keyboard() {
  local saved picked
  # Read before keyboard_udev: it removes the old F75 rule that keyboard_saved recognizes
  saved=$(keyboard_saved)
  keyboard_udev
  if [[ -n $saved && -f $(keyboard_boards_dir)/$saved.json ]]; then
    if [[ -f $KEYBOARD_CHOICE ]]; then
      ok "Keyboard: $(keyboard_name "$saved") (change it: facet keyboard set)"
    else
      keyboard_save "$saved"
    fi
  elif command -v jq >/dev/null; then
    picked=$(keyboard_pick)
    [[ -z $picked ]] || keyboard_save "$picked"
  fi
  keyboard_connected || info "No supported keyboard plugged in right now; the app finds it once it is"
  info "Super+K opens the keyboard app; it starts as a dry run and sends nothing"
  info "First test on the board: frame-keyboard list, then frame-keyboard info --live (docs/boards/ in the keyboard repo)"
}

# The keyboard app is live once keyboardLive is true in Config.qml (after the first test)
keyboard_live() {
  grep -qsE '^\s*readonly property bool keyboardLive: true' "$(pkg_dir quickshell)/.config/quickshell/config/Config.qml"
}

# New theme, new key colors. They are saved on the keyboard, so this only runs on a theme
# change, and a board that shows another effect keeps it (--keep-effect)
keyboard_theme() {
  local bin="$HOME/.local/bin/frame-keyboard" name
  keyboard_connected && [[ -x $bin ]] || return 0
  name=$(keyboard_name "$(keyboard_saved)")
  [[ -n $name ]] || name="Keyboard"
  if ! keyboard_live; then
    info "$name: the keys take the theme colors once keyboardLive is true in Config.qml"
    return 0
  fi
  if run_quiet "$bin" style split --keep-effect --live; then
    ok "$name keys in the theme colors (they show with the self-define effect)"
  else
    warn "$name: could not set the key colors, try: frame-keyboard style split --live"
  fi
}

# facet keyboard [list|search <text>|set [board]|request]
cmd_keyboard() {
  local action=${1:-} id
  (($#)) && shift
  if [[ $action == request || $action == missing ]]; then
    keyboard_request_hint
    return 0
  fi
  has_module keyboard || die "The keyboard module is not installed" "add it: facet add keyboard"
  command -v jq >/dev/null || die "facet keyboard needs jq" "install it: sudo pacman -S jq"
  case $action in
    "" | status)
      id=$(keyboard_saved)
      if [[ -n $id ]]; then
        ok "Keyboard: $(keyboard_name "$id") ($id)"
      else
        info "No keyboard picked yet (facet keyboard set)"
      fi
      for id in $(keyboard_detected); do info "Plugged in, uses the same USB id: $(keyboard_name "$id") ($id)"; done
      ;;
    list | ls | search | find)
      if [[ $action == search || $action == find ]] && (($# == 0)); then
        die "Search for what?" "facet keyboard search <vendor or model>, e.g. facet keyboard search aula 75"
      fi
      local vendor name tested usb aliases hay word found=0 cur
      cur=$(keyboard_saved)
      while IFS=$'\t' read -r id vendor name tested usb aliases; do
        hay="${id,,} ${vendor,,} ${name,,} ${aliases,,}"
        for word in "$@"; do [[ $hay == *"${word,,}"* ]] || continue 2; done
        found=1
        if [[ $id == "$cur" ]]; then
          printf '  %s❯%s %s%-15s%s %-20s %s%s · %s%s\n' "$c_primary" "$c_reset" "$c_bold" "$id" "$c_reset" "$name" "$c_muted" "$usb" "$tested" "$c_reset"
        else
          printf '    %-15s %-20s %s%s · %s%s\n' "$id" "$name" "$c_muted" "$usb" "$tested" "$c_reset"
        fi
      done < <(keyboard_board_rows)
      if ((!found)); then
        warn "No board matches: $*"
        keyboard_request_hint
      elif [[ $action == list || $action == ls ]]; then
        info "Pick yours: facet keyboard set [board]"
      fi
      ;;
    set | use | pick)
      id=${1:-}
      if [[ -z $id ]]; then
        interactive || die "Which board?" "name it: facet keyboard set <board> (all of them: facet keyboard list)"
        id=$(keyboard_pick)
        [[ -n $id ]] || return 0
      fi
      if [[ ! -f $(keyboard_boards_dir)/$id.json ]]; then
        die "Unknown board: $id" "$(did_you_mean "$id" $(keyboard_board_rows | cut -f1))facet keyboard list shows them"
      fi
      keyboard_save "$id"
      ;;
    *)
      die "Unknown action: $action" "$(did_you_mean "$action" list search set request)facet keyboard list, search <text>, set [board] or request"
      ;;
  esac
}

# ── Notification daemons ─────────────────────────────────────
# Only one program can own the notification service on D-Bus. mako, dunst or
# swaync would take the notifications away from the shell; so would noctalia, the shell
# CachyOS ships with Hyprland (its bar, launcher and keys go too, frameshell has its own).

notification_conflicts() {
  local d
  for d in mako dunst swaync noctalia; do
    if { command -v pgrep >/dev/null && pgrep -x "$d" >/dev/null; } \
      || systemctl --user is-enabled "$d.service" >/dev/null 2>&1 \
      || grep -qsE "^[[:space:]]*exec(-once)?[[:space:]]*=.*\b$d\b" "$HOME"/.config/hypr/*.conf \
      || grep -qsE "exec_cmd\([^)]*\b$d\b" "$HOME"/.config/hypr/*.lua; then
      echo "$d"
    fi
  done
  return 0
}

# Stops them, disables their user services and comments out their autostart lines
# (exec-once in hyprland.conf, hl.exec_cmd in hyprland.lua)
disable_notification_daemons() {
  local d f files=()
  for f in "$HOME"/.config/hypr/*.conf "$HOME"/.config/hypr/*.lua; do
    [[ -f $f && ! -L $f ]] && files+=("${f#"$HOME"/}")
  done
  snapshot_files notification-daemons "${files[@]}"
  for d in "$@"; do
    if systemctl --user is-enabled "$d.service" >/dev/null 2>&1; then
      run systemctl --user disable --now "$d.service" || true
    fi
    if command -v pkill >/dev/null; then
      run pkill -x "$d" || true
    fi
    for f in "${files[@]}"; do
      if [[ $f == *.lua ]]; then
        run sed -i -E "s|^([[:space:]]*hl\\.exec_cmd\\(.*\\b$d\\b.*)|-- frame: \\1|" "$HOME/$f"
      else
        run sed -i -E "s|^([[:space:]]*exec(-once)?[[:space:]]*=.*\\b$d\\b.*)|# frame: \\1|" "$HOME/$f"
      fi
    done
  done
  ok "Turned off: $* (facet restore brings them back)"
}

post_quickshell() {
  local found=()
  mapfile -t found < <(notification_conflicts)
  if ((${#found[@]})); then
    warn "Other notification daemons found: ${found[*]}"
    info "Only one program can show notifications; for the shell's popups they have to go"
    if confirm "Turn them off?"; then
      disable_notification_daemons "${found[@]}"
    else
      info "Left them on; notifications go to ${found[0]} instead of the shell"
    fi
  fi
  info "Quickshell reloads on its own. Test the lockscreen with: qs ipc call lock lock"
  if command -v pgrep >/dev/null && ! pgrep -x qs >/dev/null && ! pgrep -x quickshell >/dev/null; then
    info "Quickshell is not running yet; start it with: qs -d (or log in again)"
  fi
  return 0
}

# Hooks frame/shell.lua into the user's own hyprland.lua instead of owning it.
# Hyprland 0.55+ reads hyprland.lua first; hyprland.conf (hyprlang) is being dropped.
post_hypr() {
  local lua="$HOME/.config/hypr/hyprland.lua" conf="$HOME/.config/hypr/hyprland.conf"
  local line='require("frame/shell")'
  if [[ ! -f $lua ]]; then
    if [[ -f $conf ]]; then
      warn "Your Hyprland config is hyprland.conf, the old format; frameshell's Hyprland files are Lua"
      info "Hyprland 0.55+ reads hyprland.lua instead and drops hyprland.conf soon. Move your settings to"
      info "hyprland.lua (Hyprland's example: https://github.com/hyprwm/Hyprland/blob/main/example/hyprland.lua),"
      info "then run: facet install hypr"
    else
      warn "No ~/.config/hypr/hyprland.lua found. Add this line to your Hyprland config:"
      info "$line"
    fi
    return 0
  fi
  if grep -qF "$line" "$lua"; then
    ok "hyprland.lua already loads frame/shell"
  else
    snapshot_files hyprland-lua ".config/hypr/hyprland.lua"
    if ((DRY_RUN)); then
      info "would append to $lua: $line"
    else
      printf '\n-- frameshell: Quickshell, keybinds, idle, hotkey overlay and window colors\n%s\n' "$line" >>"$lua"
      ok "Added to hyprland.lua: $line"
    fi
  fi
  # Binds frame adds (frame/shell.lua, frame/apps.lua) that the user's config may already
  # have, as hl.bind("SUPER + L", …) or hl.bind(mainMod .. " + L", …); a doubled bind runs both
  local key dupes=()
  for key in L SPACE C W E B; do
    grep -qiE "hl\.bind\([^,]*(SUPER|mainMod)[^,]*\+ *$key\"" "$lua" && dupes+=("SUPER+$key")
  done
  if ((${#dupes[@]})); then
    warn "hyprland.lua also binds ${dupes[*]}; facet binds them too, remove your lines to avoid doubles"
  fi
  if grep -qE 'exec_cmd\("hypridle' "$lua"; then
    warn "hyprland.lua starts hypridle; the shell locks on idle by itself now, remove that line (or it locks twice)"
  fi
  if command -v hyprctl >/dev/null && ((!DRY_RUN)); then
    hyprctl reload >/dev/null && ok "Hyprland reloaded"
  fi
  return 0
}

# ── GRUB ─────────────────────────────────────────────────────
# GRUB reads its theme from /boot before /home exists, so the theme is
# copied there instead of linked.

need_grub() {
  [[ -f /boot/grub/grub.cfg ]] && command -v grub-mkconfig >/dev/null \
    || die "This system does not boot with GRUB (no /boot/grub/grub.cfg)" "nothing to theme here; facet boot themes the boot splash"
}

# Path of a JetBrains Mono TTF in the given style (Regular, Bold)
grub_font_src() {
  local style=$1 f
  for f in /usr/share/fonts/TTF/JetBrainsMono-"$style".ttf \
           /usr/share/fonts/truetype/jetbrains-mono/JetBrainsMono-"$style".ttf; do
    [[ -f $f ]] && { echo "$f"; return 0; }
  done
  f=$(fc-match -f '%{file}' "JetBrains Mono:style=$style" 2>/dev/null || true)
  [[ $f == *JetBrains* ]] && echo "$f"
  return 0
}

grub_apply() {
  local tmp regular bold images
  tmp="$(mktemp -d)"
  [[ -f $(screens_dir)/grub/frameshell/theme.txt ]] || theme_render "$(current_theme)" 0 quiet
  images="$(screens_dir)/grub/frameshell/images.sh"
  # bloom draws its card, pill and ring pictures and builds its fonts itself
  if [[ -f $images ]]; then
    step "Fonts"
    run bash "$images" "$tmp"
    ok "Fonts and pictures made"
    step "Theme files"
    run sudo install -d "$GRUB_THEME_DIR"
    run sudo cp "$(screens_dir)/grub/frameshell/theme.txt" "$tmp"/*.png "$tmp"/*.pf2 "$GRUB_THEME_DIR/"
    rm -rf "$tmp"
    ok "Copied to $GRUB_THEME_DIR"
    grub_config
    return
  fi
  step "Fonts"
  regular=$(grub_font_src Regular)
  bold=$(grub_font_src Bold)
  if [[ -z $regular || -z $bold ]] && ((!DRY_RUN)); then
    die "JetBrains Mono not found" "install it: sudo pacman -S ttf-jetbrains-mono"
  fi
  # Names must match theme.txt: "Frame Mono Regular 16" etc.
  run grub-mkfont -n "Frame Mono" -s 14 -o "$tmp/frame-regular-14.pf2" "$regular"
  run grub-mkfont -n "Frame Mono" -s 16 -o "$tmp/frame-regular-16.pf2" "$regular"
  run grub-mkfont -n "Frame Mono" -s 16 -o "$tmp/frame-bold-16.pf2" "$bold"
  ok "Fonts built"

  step "Theme files"
  # theme.txt comes from the theme templates; the frame pieces are drawn here
  local theme line_color select_color f
  theme=$(current_theme)
  line_color=$(theme_hex "$theme" surface2)
  select_color=$(theme_hex "$theme" primary)
  [[ -f $(screens_dir)/grub/frameshell/theme.txt ]] || theme_render "$theme" 0 quiet
  for f in border select_c select_e select_n select_ne select_s select_se; do
    png_solid "$tmp/$f.png" 1 "$line_color"
  done
  # The left edge of the selected entry is a 3px bar in the primary color
  for f in select_nw select_w select_sw; do
    png_solid "$tmp/$f.png" 3 "$select_color"
  done
  run sudo install -d "$GRUB_THEME_DIR"
  run sudo cp "$(screens_dir)/grub/frameshell/theme.txt" "$tmp"/*.png "$tmp"/*.pf2 "$GRUB_THEME_DIR/"
  rm -rf "$tmp"
  ok "Copied to $GRUB_THEME_DIR"
  grub_config
}

# GRUB_THEME in /etc/default/grub (the original kept once) and grub.cfg made again
grub_config() {
  step "GRUB config"
  if [[ ! -f $STATE_DIR/grub-default.orig ]]; then
    run mkdir -p "$STATE_DIR"
    run cp "$GRUB_DEFAULT_FILE" "$STATE_DIR/grub-default.orig"
    ok "Original saved to $STATE_DIR/grub-default.orig"
  fi
  local line="GRUB_THEME=\"$GRUB_THEME_DIR/theme.txt\""
  if grep -qE '^#?GRUB_THEME=' "$GRUB_DEFAULT_FILE"; then
    run sudo sed -i -E "s|^#?GRUB_THEME=.*|$line|" "$GRUB_DEFAULT_FILE"
  else
    run sudo sed -i "\$a $line" "$GRUB_DEFAULT_FILE"
  fi
  ok "Set $line"
  # A theme needs the graphical terminal
  if grep -qE '^GRUB_TERMINAL_OUTPUT=.*console' "$GRUB_DEFAULT_FILE"; then
    run sudo sed -i -E 's|^(GRUB_TERMINAL_OUTPUT=.*console.*)|#\1|' "$GRUB_DEFAULT_FILE"
    warn "Commented out GRUB_TERMINAL_OUTPUT=console"
  fi

  step "grub.cfg"
  task "Rebuilding grub.cfg" "" sudo grub-mkconfig -o /boot/grub/grub.cfg
  ok "Rebuilt /boot/grub/grub.cfg"
}

# ── GoXLR lighting ──────────────────────────────────────────
# The GoXLR's lights follow the theme: faders as a gradient meter from secondary (top) to
# primary, mute and cough buttons primary when off (dimmed) and danger when muted, global
# and accent light in primary and accent, and the "Simple" animation (the only one the
# Mini has besides the rainbows) breathing through it. Sent over goxlr-utility's HTTP API
# and saved into the loaded profile, so it survives a restart.
GOXLR_API="${GOXLR_API:-http://localhost:14564}"

goxlr_hex() {
  # "#5d6fe8" → "5D6FE8"
  local v=${1#\#}
  printf '%s' "${v^^}"
}

goxlr_serial() {
  curl -s --max-time 2 "$GOXLR_API/api/get-devices" 2>/dev/null | jq -r '.mixers | keys[0] // empty' 2>/dev/null
}

goxlr_send() {
  # goxlr_send <serial> <command json>
  local out
  out=$(curl -s --max-time 2 -X POST "$GOXLR_API/api/command" -H 'Content-Type: application/json' -d "{\"Command\":[\"$1\",$2]}" 2>/dev/null)
  [[ $out == '"Ok"' ]]
}

# goxlr_lighting <theme id> [quiet]: needs load_palette to have run for that theme
goxlr_lighting() {
  local id=$1 quiet=${2:-} serial
  serial=$(goxlr_serial)
  if [[ -z $serial ]]; then
    [[ -n $quiet ]] || info "No GoXLR (goxlr-utility is not answering on $GOXLR_API)"
    return 0
  fi
  if ((DRY_RUN)); then
    info "would light the GoXLR ($serial) in the ${PALETTE[name]} colors"
    return 0
  fi
  local primary secondary accent danger
  primary=$(goxlr_hex "${PALETTE[colors.primary]}")
  secondary=$(goxlr_hex "${PALETTE[colors.secondary]}")
  accent=$(goxlr_hex "${PALETTE[colors.accent]}")
  danger=$(goxlr_hex "${PALETTE[colors.danger]}")
  local fails=0 f b
  goxlr_send "$serial" "{\"SetSimpleColour\":[\"Global\",\"$primary\"]}" || fails=$((fails + 1))
  goxlr_send "$serial" "{\"SetSimpleColour\":[\"Accent\",\"$accent\"]}" || fails=$((fails + 1))
  for f in A B C D; do
    goxlr_send "$serial" "{\"SetFaderDisplayStyle\":[\"$f\",\"GradientMeter\"]}" || fails=$((fails + 1))
    goxlr_send "$serial" "{\"SetFaderColours\":[\"$f\",\"$secondary\",\"$primary\"]}" || fails=$((fails + 1))
  done
  for b in Fader1Mute Fader2Mute Fader3Mute Fader4Mute Bleep Cough; do
    goxlr_send "$serial" "{\"SetButtonColours\":[\"$b\",\"$danger\",\"$primary\"]}" || fails=$((fails + 1))
    goxlr_send "$serial" "{\"SetButtonOffStyle\":[\"$b\",\"DimmedColour2\"]}" || fails=$((fails + 1))
  done
  # Mod1 is the pace of the Simple animation; Ripple and Mod2 only exist on the full GoXLR
  goxlr_send "$serial" '{"SetAnimationMode":"Simple"}' || fails=$((fails + 1))
  goxlr_send "$serial" '{"SetAnimationMod1":50}' || true
  goxlr_send "$serial" '{"SetAnimationWaterfall":"Down"}' || true
  goxlr_send "$serial" '"SaveProfile"' || fails=$((fails + 1))
  if ((fails)); then
    warn "GoXLR: $fails of the lighting commands failed (goxlr-utility $GOXLR_API)"
  else
    ok "GoXLR lit in the ${PALETTE[name]} colors"
  fi
}

cmd_goxlr() {
  header
  command -v jq >/dev/null || die "facet goxlr needs jq" "install it: sudo pacman -S jq"
  command -v curl >/dev/null || die "facet goxlr needs curl" "install it: sudo pacman -S curl"
  local id
  id=$(current_theme)
  load_palette "$id"
  step "GoXLR lighting (${PALETTE[name]})"
  [[ -n $(goxlr_serial) ]] || die "goxlr-utility is not answering on $GOXLR_API" "start it (goxlr-daemon &) or install it: paru -S goxlr-utility"
  goxlr_lighting "$id"
}

# ── Sound channels ──────────────────────────────────────────
# Without a GoXLR: virtual outputs per channel the way the GoXLR has them (System, Game, Chat,
# Music by default), so the shell's mixer can put apps on them, the control center gets a
# fader and a mute per channel and a recording gets a track per channel. Strictly optional:
# nothing exists until `facet audio channels on` (or the setup question, default no).
#
# Each channel is one PipeWire loopback (libpipewire-module-loopback): a sink apps play into
# (node facet-<key>, "Game" in pavucontrol) and a stream from it into the real output
# (facet-<key>.output, target.object = that output). They live in a drop-in that PipeWire
# reads at every start, $CHANNELS_CONF, so they survive reboots; System becomes the default
# output, so every app that is not moved anywhere plays there. WirePlumber never links a
# loopback back into its own group, and the streams are passive, so idle channels let the
# output suspend. A sink with a channel's name that is already there (your own virtual sink,
# not facet's and not the GoXLR's) is taken over instead of making a second one.
#
# What the shell needs to find them goes to $CHANNELS_STATE (the shell reads it, never
# writes it): the output, and per channel its key, label, sink and whether facet made it.
# `facet audio channels off` removes the drop-in, the state and the shell's mixer memory and
# puts every app back on the output. Needs pactl (libpulse) on PipeWire and jq.
CHANNELS_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/pipewire/pipewire.conf.d/facet-channels.conf"
CHANNELS_STATE="$STATE_DIR/audio-channels.json"
# The mixer's per-app choices for the virtual channels (services/Channels.qml)
CHANNELS_ROUTES="$STATE_DIR/audio-routes.json"
CHANNELS_DEFAULT=(system game chat music)

channels_needs() {
  command -v jq >/dev/null || die "facet audio needs jq" "install it: sudo pacman -S jq"
  command -v pactl >/dev/null || die "facet audio needs pactl" "install it: sudo pacman -S libpulse"
  pactl info 2>/dev/null | grep -qi pipewire \
    || die "pactl does not reach PipeWire" "the virtual channels need PipeWire with pipewire-pulse (CachyOS default): sudo pacman -S pipewire-pulse"
}

channels_on_now() { [[ -f $CHANNELS_STATE ]]; }

# Sink node names, one per line
channels_sinks() { pactl list short sinks 2>/dev/null | awk '{ print $2 }'; }
channels_has_sink() { channels_sinks | grep -qxF -- "$1"; }

# A sink that already stands for <key> and is not facet's or the GoXLR's: its node name or
# description is the key (any case, without spaces, - and _), e.g. a "Game" made by hand
channels_existing() {
  pactl -f json list sinks 2>/dev/null | jq -r --arg k "$1" '
    def norm: ascii_downcase | gsub("[\\s_-]"; "");
    first(.[] | select((.name | startswith("facet-")) | not) | select(.name != "frame-rec")
      | select(((.description // "") + " " + .name) | test("goxlr"; "i") | not)
      | select((.name | norm) == $k or ((.description // "") | norm) == $k) | .name) // empty' 2>/dev/null
}

# Where the channels play into: the one asked for, the default output unless it is one of
# ours, the one from the last setup, or the first real output
channels_pick_output() {
  local want=${1:-} sink
  if [[ -n $want ]]; then
    channels_has_sink "$want" || die "No output called $want" "the names: pactl list short sinks"
    [[ $want != facet-* ]] || die "$want is one of the channels" "pick a real output (pactl list short sinks)"
    echo "$want"
    return 0
  fi
  sink=$(pactl get-default-sink 2>/dev/null || true)
  if [[ -n $sink && $sink != facet-* ]] && ! channels_state_has_sink "$sink"; then
    echo "$sink"
    return 0
  fi
  sink=$(channels_state_output)
  if [[ -n $sink ]] && channels_has_sink "$sink"; then
    echo "$sink"
    return 0
  fi
  channels_sinks | grep -v -e '^facet-' -e '^frame-rec$' | head -n 1
}

channels_state_output() { [[ -f $CHANNELS_STATE ]] && jq -r '.output // empty' "$CHANNELS_STATE" 2>/dev/null; return 0; }
channels_state_keys() { [[ -f $CHANNELS_STATE ]] && jq -r '.channels[].key' "$CHANNELS_STATE" 2>/dev/null; return 0; }
channels_state_has_sink() { [[ -f $CHANNELS_STATE ]] && jq -e --arg s "$1" 'any(.channels[]; .sink == $s)' "$CHANNELS_STATE" >/dev/null 2>&1; }

# One loopback in the drop-in: channels_module <key> <label> <output>
channels_module() {
  cat <<EOF
  { name = libpipewire-module-loopback
    args = {
      node.description = "$2"
      audio.position = [ FL FR ]
      capture.props = {
        node.name = "facet-$1"
        node.description = "$2"
        media.class = "Audio/Sink"
      }
      playback.props = {
        node.name = "facet-$1.output"
        node.description = "$2 (to the output)"
        target.object = "$3"
        stream.dont-remix = true
        node.passive = true
      }
    }
  }
EOF
}

# PipeWire reads the drop-in only at its start; WirePlumber and pipewire-pulse go along
channels_restart_pipewire() {
  task "Restarting PipeWire" "" systemctl --user restart pipewire.service pipewire-pulse.service wireplumber.service \
    || die "Could not restart PipeWire" "systemctl --user status pipewire wireplumber"
  ((DRY_RUN)) && return 0
  local i
  for i in $(seq 1 50); do
    pactl info >/dev/null 2>&1 && break
    sleep 0.2
  done
}

# Waits until every listed sink is there (after the restart), up to 10 s
channels_wait_sinks() {
  ((DRY_RUN)) && return 0
  local i s missing
  for i in $(seq 1 50); do
    missing=0
    for s in "$@"; do channels_has_sink "$s" || missing=1; done
    ((missing)) || return 0
    sleep 0.2
  done
  return 1
}

# The shell only notices the new PipeWire after a restart of its own
channels_restart_shell() {
  if pgrep -x qs >/dev/null 2>&1 && [[ -x $HOME/.local/bin/frame-shell-watchdog ]]; then
    run_quiet "$HOME/.local/bin/frame-shell-watchdog" restart || true
    info "The shell restarted to pick up the new outputs"
  fi
}

# Moves every app playing on <sink...> to <output>
channels_move_apps() {
  local output=$1 idx
  shift
  ((DRY_RUN)) && { info "would move the apps on ${*} to $output"; return 0; }
  pactl -f json list sink-inputs 2>/dev/null | jq -r --argjson sinks "$(printf '%s\n' "$@" | jq -R . | jq -s .)" \
    --argjson ids "$(pactl -f json list sinks 2>/dev/null | jq '[.[] | {(.index | tostring): .name}] | add // {}')" '
    .[] | select((.properties["node.name"] // "") | startswith("facet-") | not)
    | select(($ids[(.sink | tostring)] // "") as $s | $sinks | index($s)) | .index' 2>/dev/null \
    | while read -r idx; do
      pactl move-sink-input "$idx" "$output" 2>/dev/null || true
    done
}

# Moves the channels' own loopback streams to <output> right away
channels_move_loopbacks() {
  local output=$1 idx
  ((DRY_RUN)) && { info "would move the channels to $output"; return 0; }
  pactl -f json list sink-inputs 2>/dev/null \
    | jq -r '.[] | select((.properties["node.name"] // "") | test("^facet-.*\\.output$")) | .index' 2>/dev/null \
    | while read -r idx; do
      pactl move-sink-input "$idx" "$output" 2>/dev/null || true
    done
}

# facet audio channels on [key...] [--output <sink>]
channels_on() {
  local output="" keys=() key label sink made existing list='[]' modules="" made_any=0 default=""
  while (($#)); do
    case $1 in
      --output) output=${2:-}; [[ -n $output ]] || die "--output needs a sink name" "the names: pactl list short sinks"; shift ;;
      --output=*) output=${1#--output=} ;;
      *) keys+=("${1,,}") ;;
    esac
    shift
  done
  ((${#keys[@]})) || mapfile -t keys < <(channels_state_keys)
  ((${#keys[@]})) || keys=("${CHANNELS_DEFAULT[@]}")
  for key in "${keys[@]}"; do
    [[ $key =~ ^[a-z][a-z0-9]{0,15}$ ]] || die "Not a channel name: $key" "letters and digits, e.g. facet audio channels on system game chat music"
  done
  if [[ " ${keys[*]} " != *" system "* ]]; then
    warn "No system channel: apps that are not moved anywhere keep playing straight on the output"
  fi
  if goxlr_connected; then
    warn "A GoXLR is connected; its channels stay the ones the shell uses unless you pick \"virtual\" in settings > sound"
  fi

  step "Sound channels"
  output=$(channels_pick_output "$output")
  [[ -n $output ]] || die "No output found to play the channels into" "is a sound device connected? pactl list short sinks"
  info "Output: $output"

  for key in "${keys[@]}"; do
    label=${key^}
    existing=$(channels_existing "$key")
    if [[ -n $existing ]]; then
      sink=$existing made=false
      ok "$label: takes your existing sink $existing"
    else
      sink="facet-$key" made=true made_any=1
      modules+=$(channels_module "$key" "$label" "$output")$'\n'
      ok "$label: new sink $sink"
    fi
    list=$(jq -c --arg k "$key" --arg l "$label" --arg s "$sink" --argjson m "$made" \
      '. + [{ key: $k, label: $l, sink: $s, made: $m }]' <<<"$list")
    [[ $key == system ]] && default=$sink
  done

  if ((DRY_RUN)); then
    ((made_any)) && info "would write $CHANNELS_CONF"
    info "would write $CHANNELS_STATE"
  else
    if ((made_any)); then
      mkdir -p "$(dirname "$CHANNELS_CONF")"
      {
        echo "# Written by \`facet audio channels on\`; \`facet audio channels off\` removes it."
        echo "# One loopback per channel: a sink apps play into (facet-<key>) and a stream from it"
        echo "# into the real output (facet-<key>.output). Change the output with"
        echo "# \`facet audio channels output <sink>\`, the channels with \`facet audio channels on <keys>\`."
        echo "context.modules = ["
        printf '%s' "$modules"
        echo "]"
      } >"$CHANNELS_CONF"
    else
      rm -f "$CHANNELS_CONF"
    fi
    mkdir -p "$STATE_DIR"
    jq -n --arg o "$output" --argjson c "$list" '{ version: 1, output: $o, channels: $c }' >"$CHANNELS_STATE"
  fi

  channels_restart_pipewire
  # shellcheck disable=SC2046
  if ! channels_wait_sinks $(jq -r '.channels[].sink' <<<"{\"channels\":$list}"); then
    warn "Not every channel showed up in PipeWire; check: pactl list short sinks, journalctl --user -u pipewire"
  fi
  if [[ -n $default ]]; then
    run pactl set-default-sink "$default" || warn "Could not make $default the default output"
    ok "Default output: ${default} (System)"
  fi
  channels_restart_shell
  ok "Sound channels on: ${keys[*]}"
  hint "move apps in the app mixer; rules for apps in settings > sound; off again: facet audio channels off"
}

channels_off() {
  step "Sound channels"
  if ! channels_on_now && [[ ! -f $CHANNELS_CONF ]]; then
    ok "No sound channels set up, nothing to remove"
    return 0
  fi
  local output sinks=()
  output=$(channels_state_output)
  if [[ -z $output ]] || ! channels_has_sink "$output"; then
    output=$(channels_sinks | grep -v -e '^facet-' -e '^frame-rec$' | head -n 1)
  fi
  [[ -f $CHANNELS_STATE ]] && mapfile -t sinks < <(jq -r '.channels[].sink' "$CHANNELS_STATE" 2>/dev/null)
  # Apps first, so WirePlumber remembers the real output for them, not a channel that is gone
  if [[ -n $output ]]; then
    ((${#sinks[@]})) && channels_move_apps "$output" "${sinks[@]}"
    run pactl set-default-sink "$output" || true
    ok "Apps and the default output back on $output"
  fi
  run rm -f "$CHANNELS_CONF" "$CHANNELS_STATE" "$CHANNELS_ROUTES"
  channels_restart_pipewire
  [[ -n $output ]] && { run pactl set-default-sink "$output" >/dev/null 2>&1 || true; }
  channels_restart_shell
  ok "Sound channels removed"
}

# facet audio channels output <sink>: where the channels play into, now and after a restart
channels_output() {
  local want=${1:-} output
  channels_on_now || die "No sound channels set up" "facet audio channels on"
  [[ -n $want ]] || die "Name the output" "the names: pactl list short sinks"
  output=$(channels_pick_output "$want")
  if [[ -f $CHANNELS_CONF ]]; then
    if ((DRY_RUN)); then
      info "would point $CHANNELS_CONF at $output"
    else
      sed -i "s|^\(\s*target\.object = \)\"[^\"]*\"|\1\"$output\"|" "$CHANNELS_CONF"
    fi
  fi
  if ((!DRY_RUN)); then
    jq --arg o "$output" '.output = $o' "$CHANNELS_STATE" >"$CHANNELS_STATE.tmp" && mv "$CHANNELS_STATE.tmp" "$CHANNELS_STATE"
  fi
  channels_move_loopbacks "$output"
  ok "Channels play into $output"
}

channels_status() {
  step "Sound channels"
  if goxlr_connected; then
    ok "GoXLR connected: its channels come from GoXLR Utility"
  fi
  if ! channels_on_now; then
    info "Virtual channels: not set up (facet audio channels on)"
    return 0
  fi
  local key label sink made output
  output=$(channels_state_output)
  while IFS=$'\t' read -r key label sink made; do
    if command -v pactl >/dev/null && channels_has_sink "$sink"; then
      ok "$label → $sink$([[ $made == false ]] && echo " (yours, taken over)")"
    else
      warn "$label → $sink is missing in PipeWire (facet audio channels on sets it up again)"
    fi
  done < <(jq -r '.channels[] | [.key, .label, .sink, (.made | tostring)] | @tsv' "$CHANNELS_STATE" 2>/dev/null)
  if [[ -n $output ]]; then
    if command -v pactl >/dev/null && channels_has_sink "$output"; then ok "Output: $output"; else warn "Output $output is not there right now"; fi
  fi
  [[ -f $CHANNELS_CONF ]] && info "Config: ${CHANNELS_CONF/#"$HOME"/\~}"
}

# facet audio channels [on [key...] [--output <sink>]|off|output <sink>|status]
cmd_audio() {
  local what=${1:-} action=${2:-status}
  case $what in
    channels | ch) shift; shift || true ;;
    "" | status) header; channels_status; return 0 ;;
    *) die "Unknown: facet audio $what" "facet audio channels on|off|output <sink>|status" ;;
  esac
  header
  case $action in
    on | enable) channels_needs; channels_on "$@" ;;
    off | disable | remove) channels_needs; channels_off ;;
    output) channels_needs; channels_output "$@" ;;
    status | "") channels_status ;;
    *)
      die "Unknown: facet audio channels $action" "$(did_you_mean "$action" on off output status)facet audio channels on|off|output <sink>|status"
      ;;
  esac
}

# The setup's question (default no) said yes. Run in a subshell by cmd_install, so a
# missing piece only warns instead of ending the install.
setup_channels() {
  channels_needs
  channels_on
}

# ── Login screen ────────────────────────────────────────────
# One user, one screen: the lockscreen's look as the greeter. greetd runs
# frame-greeter-session (greeter/), which starts a small compositor (the one CachyOS
# ships with noctalia-greeter, or cage) with Quickshell drawing greeter/shell.qml. The
# greeter user cannot read your home, so the files go to /usr/share/frameshell/greeter;
# everything under /etc/greetd and /usr/share needs sudo.
GREETD_CONFIG="/etc/greetd/config.toml"
GREETER_DIR="/usr/share/frameshell/greeter"
# Second copy of the original next to it, so `facet login remove` works even when the
# state folder is gone
GREETD_BACKUP_SUFFIX=".frameshell-orig"

# The file greetd really reads: its unit may pass --config/-c (a distro drop-in)
greetd_config_path() {
  local exec_line path
  exec_line=$(systemctl show -p ExecStart --value greetd.service 2>/dev/null || true)
  path=$(sed -n 's/.*argv\[\]=[^;]*\(--config\|-c\)[ =]\([^ ;]*\).*/\2/p' <<<"$exec_line")
  echo "${path:-/etc/greetd/config.toml}"
}

# What [default_session] command currently says
greetd_default_command() {
  awk '/^\[default_session\]/{s=1; next} /^\[/{s=0} s && /^[[:space:]]*command[[:space:]]*=/{sub(/^[^=]*=[[:space:]]*/, ""); gsub(/"/, ""); print; exit}' "$1"
}

# greetd has to be the display manager that systemd starts
greetd_is_display_manager() {
  local dm
  dm=$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null || true)
  [[ $dm == */greetd.service ]]
}

# Puts the original config back; with no copy at all it refuses, so greetd never
# points at a greeter that is about to be deleted
greetd_restore() {
  local orig
  for orig in "$STATE_DIR/greetd-config.orig" "$GREETD_CONFIG$GREETD_BACKUP_SUFFIX"; do
    if [[ -s $orig ]]; then
      run sudo install -m 644 "$orig" "$GREETD_CONFIG"
      ok "Restored $GREETD_CONFIG from $orig"
      return 0
    fi
  done
  return 1
}

login_session_command() {
  # The command greetd runs for the session, the way the distro starts Hyprland
  if [[ -x /usr/bin/start-hyprland ]]; then
    echo "/usr/bin/start-hyprland"
  elif command -v uwsm >/dev/null; then
    echo "uwsm start -e -D Hyprland hyprland.desktop"
  else
    echo "Hyprland"
  fi
}

cmd_login() {
  local action=${1:-install}
  need_arch
  header
  GREETD_CONFIG=$(greetd_config_path)
  [[ -f $GREETD_CONFIG ]] || die "greetd is not the display manager here ($GREETD_CONFIG is missing)" "facet login only works with greetd; install and enable greetd first"
  case $action in
    install)
      local user command theme_file="$(screens_theme_file)"
      user=$(id -un)
      command=$(login_session_command)
      # Everything the greeter needs, checked before greetd is touched: a broken greeter
      # leaves only a text console to log in on
      if [[ ! -x /usr/bin/noctalia-greeter-compositor ]] && ! command -v cage >/dev/null; then
        die "The greeter needs a small compositor" "install cage (sudo pacman -S cage), or noctalia-greeter on CachyOS"
      fi
      command -v qs >/dev/null || die "Quickshell (qs) is missing" "install the shell first: facet install shell"
      [[ -f $theme_file ]] || die "No rendered theme yet ($theme_file)" "write it first: facet theme"
      greetd_is_display_manager \
        || warn "systemd does not start greetd as the display manager; enable it: sudo systemctl enable greetd (after disabling the other one)"
      local owner
      owner=$(pacman -Qqo "$GREETD_CONFIG" 2>/dev/null || true)
      [[ -n $owner ]] && info "$GREETD_CONFIG belongs to the package $owner; should an update replace it, run facet login again"
      info "greetd ($GREETD_CONFIG) will show the frameshell login screen for $user and start: $command"
      confirm "Set up the lockscreen look as the login screen?" || exit 0
      step "Greeter files"
      if greeter_has_manifest; then
        greeter_install_manifest
      else
        # What bloom's greeter left there
        run sudo rm -rf "$GREETER_DIR/config" "$GREETER_DIR/components" "$GREETER_DIR/lockscreen"
        run sudo install -d -m 755 "$GREETER_DIR" "$GREETER_DIR/ui"
        run sudo install -m 644 "$(screens_dir)/greeter/shell.qml" "$GREETER_DIR/shell.qml"
        run sudo install -m 644 "$(screens_dir)/greeter/ui/Frame.qml" "$GREETER_DIR/ui/Frame.qml"
        # The active theme, as the shell has it rendered right now
        run sudo install -m 644 "$(screens_theme_file)" "$GREETER_DIR/ui/Theme.qml"
        run sudo install -m 755 "$(screens_dir)/greeter/frame-greeter-session" "$GREETER_DIR/frame-greeter-session"
      fi
      local tmp
      tmp=$(mktemp)
      printf '{ "user": "%s", "command": ["%s"] }\n' "$user" "$command" >"$tmp"
      run sudo install -m 644 "$tmp" "$GREETER_DIR/greeter.json"
      rm -f "$tmp"
      ok "Greeter in $GREETER_DIR (theme $(current_theme))"
      step "greetd"
      # Only the distro's own config counts as the original, never one frame wrote
      if ! grep -q "frameshell" "$GREETD_CONFIG"; then
        run mkdir -p "$STATE_DIR"
        run cp "$GREETD_CONFIG" "$STATE_DIR/greetd-config.orig"
        run sudo install -m 644 "$GREETD_CONFIG" "$GREETD_CONFIG$GREETD_BACKUP_SUFFIX"
        ok "Original config kept at $STATE_DIR/greetd-config.orig and $GREETD_CONFIG$GREETD_BACKUP_SUFFIX"
      fi
      tmp=$(mktemp)
      # Keep [terminal] and any other section, replace default_session
      awk 'BEGIN{skip=0} /^\[default_session\]/{skip=1; next} /^\[/{skip=0} !skip' "$GREETD_CONFIG" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' >"$tmp"
      {
        echo
        echo "# frameshell: the lockscreen look as the login screen (facet login)"
        echo "[default_session]"
        echo "command = \"$GREETER_DIR/frame-greeter-session\""
        echo "user = \"greeter\""
      } >>"$tmp"
      run sudo install -m 644 "$tmp" "$GREETD_CONFIG"
      rm -f "$tmp"
      if ((!DRY_RUN)) && [[ $(greetd_default_command "$GREETD_CONFIG") != "$GREETER_DIR/frame-greeter-session" ]]; then
        die "$GREETD_CONFIG does not name the frameshell greeter after writing it" "look at the file before rebooting"
      fi
      ok "Wrote $GREETD_CONFIG (default_session → frameshell greeter)"
      info "Try it without rebooting from a text console (Ctrl+Alt+F3): sudo systemctl restart greetd"
      info "If it stays black: journalctl -b -t frame-greeter -u greetd, and facet login remove brings the old one back"
      printf '\n%sDone.%s The next boot shows the frameshell login screen. facet theme set … updates its colors too.\n\n' "$c_ok" "$c_reset"
      ;;
    auto)
      # greetd's [initial_session] logs one user in at boot without a greeter; after a
      # logout the [default_session] greeter still shows. The lockscreen is Super+L.
      local user command
      user=$(id -un)
      command=$(login_session_command)
      greetd_is_display_manager \
        || warn "systemd does not start greetd as the display manager; enable it: sudo systemctl enable greetd (after disabling the other one)"
      info "greetd ($GREETD_CONFIG) will start $command for $user at boot, without a greeter"
      info "The session starts locked: the shell's own lockscreen asks for the password (hypr/frame/shell.lua)"
      confirm "Boot straight into the locked desktop?" || exit 0
      step "greetd"
      if ! grep -q "frameshell" "$GREETD_CONFIG"; then
        run mkdir -p "$STATE_DIR"
        run cp "$GREETD_CONFIG" "$STATE_DIR/greetd-config.orig"
        run sudo install -m 644 "$GREETD_CONFIG" "$GREETD_CONFIG$GREETD_BACKUP_SUFFIX"
        ok "Original config kept at $STATE_DIR/greetd-config.orig and $GREETD_CONFIG$GREETD_BACKUP_SUFFIX"
      fi
      local tmp
      tmp=$(mktemp)
      # Keep every other section, replace initial_session
      awk 'BEGIN{skip=0} /^\[initial_session\]/{skip=1; next} /^\[/{skip=0} !skip' "$GREETD_CONFIG" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' >"$tmp"
      {
        echo
        echo "# frameshell: straight into Hyprland at boot, no login screen (facet login auto)"
        echo "[initial_session]"
        echo "command = \"$command\""
        echo "user = \"$user\""
      } >>"$tmp"
      run sudo install -m 644 "$tmp" "$GREETD_CONFIG"
      rm -f "$tmp"
      ok "Wrote $GREETD_CONFIG (initial_session → $command as $user)"
      info "The greeter in [default_session] stays for after a logout; facet login remove brings the distro's config back"
      printf '\n%sDone.%s The next boot shows the shell\x27s lockscreen instead of the greeter.\n\n' "$c_ok" "$c_reset"
      ;;
    remove)
      confirm "Back to the distro's greeter?" || exit 0
      step "greetd"
      if ! greetd_restore; then
        # Deleting the greeter now would leave greetd pointing at nothing
        die "No copy of the original greetd config found" "set [default_session] command in $GREETD_CONFIG back by hand (CachyOS: noctalia-greeter-session), then run facet login remove again"
      fi
      step "Greeter files"
      run sudo rm -rf "$GREETER_DIR"
      ok "Removed $GREETER_DIR"
      ;;
    *) die "Unknown login action: $action" "$(did_you_mean "$action" install auto remove)facet login install, auto or remove" ;;
  esac
}

# ── Boot: splash and console colors ─────────────────────────
# The rest of the boot chain in the theme: Plymouth (between GRUB and the login screen,
# also asks for the disk password) and the text consoles' 16 colors, which show when
# something goes wrong before the desktop. Both need sudo.
PLYMOUTH_DIR="/usr/share/plymouth/themes/frameshell"
VTRGB_FILE="/etc/frameshell/vtrgb"
VTRGB_UNIT="/etc/systemd/system/frameshell-vtrgb.service"

# The theme's ansi colors as setvtrgb wants them: one line each for red, green and blue,
# 16 decimal values; color 0 is the console background, so it gets the theme's bg
vt_palette() {
  local i h r=() g=() b=()
  for ((i = 0; i < 16; i++)); do
    h=${PALETTE[ansi.$i]:-}
    ((i == 0)) && h=${PALETTE[colors.bg]}
    h=${h#\#}
    r+=($((16#${h:0:2})))
    g+=($((16#${h:2:2})))
    b+=($((16#${h:4:2})))
  done
  local IFS=,
  printf '%s\n%s\n%s\n' "${r[*]}" "${g[*]}" "${b[*]}"
}

# mkinitcpio on CachyOS, dracut on some installs: the splash lives in the initramfs
rebuild_initramfs() {
  if command -v mkinitcpio >/dev/null; then
    task "Rebuilding the initramfs (mkinitcpio)" "" sudo mkinitcpio -P
  elif command -v dracut >/dev/null; then
    task "Rebuilding the initramfs (dracut)" "" sudo dracut --regenerate-all --force
  else
    warn "Neither mkinitcpio nor dracut found; rebuild the initramfs yourself"
    return 1
  fi
}

# The installed splash differs from what the templates render now (new version or theme)
boot_splash_outdated() {
  local f src
  src=$(screens_dir)/plymouth/frameshell
  [[ -d $PLYMOUTH_DIR ]] || return 1
  for f in frameshell.plymouth frameshell.script; do
    cmp -s "$src/$f" "$PLYMOUTH_DIR/$f" || return 0
  done
  return 1
}

# The contents of the newest initramfs, empty when there is no image or no tool to list it
initramfs_listing() {
  local img
  img=$(ls -t /boot/initramfs-*.img 2>/dev/null | grep -v fallback | head -n1)
  [[ -n $img ]] || return 0
  if command -v lsinitcpio >/dev/null; then
    sudo lsinitcpio "$img" 2>/dev/null
  elif command -v lsinitrd >/dev/null; then
    sudo lsinitrd "$img" 2>/dev/null
  fi
}

# Everything that keeps the splash from showing, one line each
boot_check() {
  local hooks listing all_ok=1
  if [[ $(plymouth-set-default-theme 2>/dev/null) == frameshell ]]; then
    ok "Plymouth uses frameshell"
  else
    warn "Plymouth uses $(plymouth-set-default-theme 2>/dev/null || echo nothing), not frameshell; run facet boot"
    all_ok=0
  fi
  if boot_splash_outdated; then
    warn "The installed splash is older than the templates; run facet boot (facet update does it too)"
    all_ok=0
  fi
  if grep -qw splash /proc/cmdline 2>/dev/null; then
    ok "splash is on the kernel command line"
  else
    warn "No splash on the kernel command line, so plymouth only shows text; add splash (and quiet) in the boot loader's config"
    all_ok=0
  fi
  if [[ -f /etc/mkinitcpio.conf ]]; then
    hooks=$(grep -hE '^\s*HOOKS=' /etc/mkinitcpio.conf /etc/mkinitcpio.conf.d/*.conf 2>/dev/null | tail -n1)
    if [[ $hooks == *plymouth* ]]; then
      ok "mkinitcpio has the plymouth hook"
    else
      warn "mkinitcpio has no plymouth hook: the splash only starts once the disk is mounted, mostly too late to see; add plymouth to HOOKS in /etc/mkinitcpio.conf (after udev), then facet boot"
      all_ok=0
    fi
  fi
  listing=$(initramfs_listing)
  if [[ -n $listing ]]; then
    if grep -q 'plymouth/themes/frameshell' <<<"$listing"; then
      ok "The initramfs has the frameshell splash"
    else
      warn "The initramfs has no frameshell splash, so the boot shows the old one or none; run facet boot"
      all_ok=0
    fi
    # NVIDIA's driver loads late unless it is in the initramfs; until then plymouth has
    # no screen to draw on, and on a fast boot that is the whole boot
    if [[ -d /sys/module/nvidia ]] && ! grep -q 'nvidia[-_]drm' <<<"$listing"; then
      warn "The NVIDIA driver is not in the initramfs, so the splash gets no screen until the boot is nearly done; add nvidia nvidia_modeset nvidia_uvm nvidia_drm to MODULES in /etc/mkinitcpio.conf, then facet boot"
      all_ok=0
    fi
  fi
  # The boot's plymouth still running in the desktop: shutdown shows that one, in boot
  # mode ("starting"), instead of starting its own
  if pgrep -x plymouthd >/dev/null; then
    warn "plymouthd from the boot is still running, so shutdown shows it as a boot screen; end it after login with: sudo systemctl add-wants multi-user.target plymouth-quit.service"
    all_ok=0
  fi
  ((all_ok)) && info "All fine. A very fast boot only flashes the splash; plymouth.debug on the kernel command line writes /var/log/plymouth-debug.log"
  return 0
}

boot_splash_install() {
  if ! command -v plymouth-set-default-theme >/dev/null && ((!DRY_RUN)); then
    warn "Plymouth is not installed (pacman -S plymouth), skipping the splash"
    return 0
  fi
  local theme tmp f
  theme=$(current_theme)
  [[ -f $(screens_dir)/plymouth/frameshell/frameshell.script ]] || theme_render "$theme" 0 quiet
  tmp=$(mktemp -d)
  # bloom draws its ring and pill pictures itself (images.sh, rendered with the theme)
  if [[ -f $(screens_dir)/plymouth/frameshell/images.sh ]]; then
    run bash "$(screens_dir)/plymouth/frameshell/images.sh" "$tmp"
  else
    png_solid "$tmp/line.png" 1 "$(theme_hex "$theme" frame)"
    png_solid "$tmp/fill.png" 1 "$(theme_hex "$theme" primary)"
    png_solid "$tmp/track.png" 1 "$(theme_hex "$theme" surface2)"
    png_solid "$tmp/bg.png" 1 "$(theme_hex "$theme" bg)"
  fi
  run sudo install -d "$PLYMOUTH_DIR"
  for f in frameshell.plymouth frameshell.script; do
    run sudo install -m 644 "$(screens_dir)/plymouth/frameshell/$f" "$PLYMOUTH_DIR/$f"
  done
  run sudo install -m 644 "$tmp"/*.png "$PLYMOUTH_DIR/"
  rm -rf "$tmp"
  ok "Theme in $PLYMOUTH_DIR"

  # The theme it replaces, for facet boot remove
  if [[ ! -f $STATE_DIR/plymouth-theme.orig ]] && ((!DRY_RUN)); then
    local before
    before=$(plymouth-set-default-theme 2>/dev/null || true)
    if [[ -n $before && $before != frameshell ]]; then
      mkdir -p "$STATE_DIR"
      echo "$before" >"$STATE_DIR/plymouth-theme.orig"
    fi
  fi
  run sudo plymouth-set-default-theme frameshell
  ok "Plymouth uses frameshell"

  info "Rebuilding the initramfs, the splash is part of it (takes a minute)"
  rebuild_initramfs && ok "initramfs rebuilt"
  # Without the hook, the splash parameter or an early screen nothing shows at boot
  ((DRY_RUN)) || boot_check
}

boot_tty_install() {
  step "Console colors"
  if ! command -v setvtrgb >/dev/null && ((!DRY_RUN)); then
    warn "setvtrgb not found (pacman -S kbd), skipping the console colors"
    return 0
  fi
  local tmp
  tmp=$(mktemp)
  load_palette "$(current_theme)"
  vt_palette >"$tmp"
  run sudo install -d /etc/frameshell
  run sudo install -m 644 "$tmp" "$VTRGB_FILE"
  # Before the login screen, so a text console never shows the old colors
  cat >"$tmp" <<EOF
[Unit]
Description=frameshell colors for the text consoles
DefaultDependencies=no
After=systemd-vconsole-setup.service
Before=display-manager.service getty.target

[Service]
Type=oneshot
ExecStart=/usr/bin/setvtrgb $VTRGB_FILE

[Install]
WantedBy=sysinit.target
EOF
  run sudo install -m 644 "$tmp" "$VTRGB_UNIT"
  rm -f "$tmp"
  run sudo systemctl daemon-reload
  run sudo systemctl enable frameshell-vtrgb.service
  run_quiet sudo setvtrgb "$VTRGB_FILE" || true
  ok "Text consoles use the theme's colors (Ctrl+Alt+F3 to look)"
}

# facet boot [install|check|remove]: Plymouth splash and console colors in the theme, or why the splash does not show
cmd_boot() {
  local action=${1:-install}
  need_arch
  header
  case $action in
    install)
      info "Puts the frameshell splash ($(current_theme)) into Plymouth and the theme's colors on the text consoles (needs sudo)"
      confirm "Set up the boot splash and console colors?" || exit 0
      step "Boot splash (Plymouth)"
      boot_splash_install
      boot_tty_install
      printf '\n%sDone.%s Reboot to see the splash.\n\n' "$c_ok" "$c_reset"
      ;;
    check)
      command -v plymouth-set-default-theme >/dev/null || die "Plymouth is not installed" "install it: sudo pacman -S plymouth, then facet boot"
      step "Boot splash (Plymouth)"
      boot_check
      echo
      ;;
    remove)
      confirm "Back to the distro's splash and the default console colors?" || exit 0
      step "Boot splash"
      if command -v plymouth-set-default-theme >/dev/null; then
        local before=""
        [[ -f $STATE_DIR/plymouth-theme.orig ]] && before=$(<"$STATE_DIR/plymouth-theme.orig")
        run sudo plymouth-set-default-theme "${before:-bgrt}"
        run sudo rm -rf "$PLYMOUTH_DIR"
        rebuild_initramfs && ok "Splash back to ${before:-bgrt}"
      fi
      step "Console colors"
      run_quiet sudo systemctl disable frameshell-vtrgb.service || true
      run sudo rm -f "$VTRGB_UNIT" "$VTRGB_FILE"
      run_quiet sudo setvtrgb vga || true
      ok "Default console colors"
      ;;
    *) die "Unknown boot action: $action" "$(did_you_mean "$action" install check remove)facet boot install, check or remove" ;;
  esac
}

cmd_grub() {
  local action=${1:-install}
  need_arch
  need_grub
  header
  case $action in
    install)
      info "Copies the frameshell theme ($(current_theme)) to $GRUB_THEME_DIR and sets GRUB_THEME (needs sudo)"
      confirm "Install the GRUB theme?" || exit 0
      step "Dependencies"
      # bloom's menu is set in Rubik; gawk draws its pictures (Arch's base has it)
      if [[ $(screens_style) == bloom ]]; then install_deps ttf-rubik-vf ttf-jetbrains-mono gawk; else install_deps ttf-jetbrains-mono; fi
      grub_apply
      printf '\n%sDone.%s Reboot to see the new boot menu.\n\n' "$c_ok" "$c_reset"
      ;;
    remove)
      confirm "Remove the frameshell GRUB theme?" || exit 0
      step "GRUB config"
      # Only comment out our line; restoring the old file would drop later edits
      run sudo sed -i -E "s|^GRUB_THEME=\"$GRUB_THEME_DIR/theme.txt\"|#&|" "$GRUB_DEFAULT_FILE"
      ok "Commented out GRUB_THEME"
      step "Theme files"
      run sudo rm -rf "$GRUB_THEME_DIR"
      ok "Removed $GRUB_THEME_DIR"
      step "grub.cfg"
      task "Rebuilding grub.cfg" "" sudo grub-mkconfig -o /boot/grub/grub.cfg
      ok "Rebuilt /boot/grub/grub.cfg"
      [[ -f $STATE_DIR/grub-default.orig ]] && info "Your original /etc/default/grub is kept at $STATE_DIR/grub-default.orig"
      return 0
      ;;
    *) die "Unknown grub action: $action" "$(did_you_mean "$action" install remove)facet grub install or remove" ;;
  esac
}

# ── Theme ────────────────────────────────────────────────────
# themes/<name>.json holds a theme: the same color roles for all of them, the 16
# terminal colors and the fonts. Each module keeps templates/<package>/<path>: its app files
# with placeholders like {{colors.primary}}, {{ansi.4}} or {{colors.bg|lighten:8|rgb}}.
# facet theme fills them in and writes <package>/<path> inside the module. Those outputs are
# git-ignored, so switching themes never shows up as a change in a repo; install and update
# write them before linking.

# Set per module while rendering (theme_render); render_template names files relative to it
TEMPLATE_DIR=""
declare -A PALETTE=()

# Theme names, from the files in themes/
theme_ids() {
  find "$(themes_dir)" -maxdepth 1 -name '*.json' -printf '%f\n' | sed 's/\.json$//' | sort
}

is_theme() {
  [[ -n $1 && -f $(themes_dir)/$1.json ]]
}

# "name|description" lines for choose(), the default theme first
theme_choices() {
  local id desc
  for id in "$(default_theme)" $(theme_ids | grep -vx "$(default_theme)"); do
    desc=$(sed -n 's/.*"description": *"\([^"]*\)".*/\1/p' "$(themes_dir)/$id.json" | head -n 1)
    echo "$id|$(theme_swatch "$id")$c_muted$desc$c_reset"
  done
}

# A strip of the theme's main colors for a list row (nothing when colors are off)
theme_swatch() {
  ((USE_COLOR)) || return 0
  local r h
  for r in bg surface2 primary secondary accent text; do
    h=$(theme_hex "$1" "$r")
    [[ -n $h ]] && printf '%s  ' "$(bg_hex "$h")"
  done
  printf '%s ' "$c_reset"
}

# What menu shows under the list for the highlighted theme: every palette color, the 16
# terminal colors and a line set in them. Fills MENU_PREVIEW, one entry per theme.
theme_previews() {
  ((USE_COLOR)) || return 0
  local id role hex file entry sample plain pad
  local -A c
  for id in $(theme_ids); do
    file=$(themes_dir)/$id.json
    c=()
    while read -r role hex; do
      c[$role]=$hex
    done < <(sed -n '/"colors"/,/}/s/.*"\([A-Za-z0-9]*\)": *"#\([0-9a-fA-F]\{6\}\)".*/\1 \2/p' "$file")
    printf -v entry '\r\e[K\n\r\e[K      %s%-7s%s' "$c_muted" colors "$c_reset"
    for role in bg surface surface2 shadow primary secondary accent text textDim muted frame danger warn ok; do
      [[ -n ${c[$role]:-} ]] && entry+="$(bg_hex "${c[$role]}")   "
    done
    printf -v entry '%s%s\n\r\e[K      %s%-7s%s' "$entry" "$c_reset" "$c_muted" ansi "$c_reset"
    for hex in $(sed -n '/"ansi"/,/]/s/.*"#\([0-9a-fA-F]\{6\}\)".*/\1/p' "$file"); do
      entry+="$(bg_hex "$hex")   "
    done
    # A prompt line on the theme's background, padded to the width of the ansi row
    sample="$(bg_hex "${c[bg]:-000000}")$(fg_hex "${c[primary]:-ffffff}") ❯ $(fg_hex "${c[text]:-ffffff}")facet "
    sample+="$(fg_hex "${c[textDim]:-ffffff}")theme set $(fg_hex "${c[accent]:-ffffff}")$id  "
    sample+="$(fg_hex "${c[ok]:-ffffff}")✓ ok $(fg_hex "${c[warn]:-ffffff}")! warn $(fg_hex "${c[danger]:-ffffff}")✗ no"
    plain=" ❯ facet theme set $id  ✓ ok ! warn ✗ no"
    pad=$((48 - ${#plain}))
    ((pad > 0)) || pad=1
    printf -v pad '%*s' "$pad" ""
    printf -v entry '%s%s\n\r\e[K      %7s%s%s%s\n' "$entry" "$c_reset" "" "$sample" "$pad" "$c_reset"
    MENU_PREVIEW[$id]=$entry
  done
  MENU_PREVIEW_LINES=4
}

save_theme() {
  if ((DRY_RUN)); then
    info "would remember theme $1 in $(theme_state)"
    return 0
  fi
  mkdir -p "$STATE_DIR"
  echo "$1" >"$(theme_state)"
}

# Flattens themes/<name>.json into PALETTE: colors.primary, ansi.4, fonts.mono, name, …
load_palette() {
  local id=$1 key value
  PALETTE=()
  while IFS='=' read -r key value; do
    PALETTE[$key]=$value
  done < <(jq -r 'paths(scalars) as $p | "\($p | map(tostring) | join("."))=\(getpath($p))"' "$(themes_dir)/$id.json")
  [[ -n ${PALETTE[colors.primary]:-} ]] || die "themes/$(current_style)/$id.json has no colors.primary" "fix the file, or pick another theme: facet theme set"
  PALETTE[id]=$id
  # For templates that need a real path, e.g. Zen's home page ({{home}})
  PALETTE[home]=$HOME
  palette_tones
}

# The bloom style's Material You tones ("tones" in a theme: surface, container, primary, …).
# A theme without them (an older one, or your own) gets them made from its colors, so every
# theme works in every style; the ones it has win.
palette_tones() {
  local k bg pr
  local -A c=() t=()
  for k in bg primary secondary accent text textDim frame danger ok; do
    c[$k]=${PALETTE[colors.$k]:-#808080}
  done
  bg=${c[bg]} pr=${c[primary]}
  t[surface]=$(mix_hex "$bg" "$pr" 4)
  t[container]=$(mix_hex "${t[surface]}" "#ffffff" 5)
  t[high]=$(mix_hex "${t[surface]}" "#ffffff" 11)
  t[highest]=$(mix_hex "${t[surface]}" "#ffffff" 16)
  t[primary]=$(mix_hex "$pr" "#ffffff" 40)
  t[onPrimary]=$(mix_hex "$pr" "#000000" 70)
  t[primaryContainer]=$(mix_hex "$pr" "#000000" 50)
  t[onPrimaryContainer]=$(mix_hex "$pr" "#ffffff" 80)
  t[secondary]=${c[secondary]}
  t[secondaryContainer]=$(mix_hex "${c[secondary]}" "$bg" 72)
  t[tertiary]=$(mix_hex "${c[accent]}" "#ffffff" 30)
  t[text]=${c[text]}
  t[dim]=${c[textDim]}
  t[outline]=$(mix_hex "${c[frame]}" "$bg" 30)
  t[page]=$(mix_hex "$bg" "#000000" 30)
  t[ok]=${c[ok]}
  t[okContainer]=$(mix_hex "${c[ok]}" "#000000" 70)
  t[error]=$(mix_hex "${c[danger]}" "#ffffff" 35)
  t[errorContainer]=$(mix_hex "${c[danger]}" "#000000" 50)
  for k in "${!t[@]}"; do
    [[ -n ${PALETTE[tones.$k]:-} ]] || PALETTE[tones.$k]=${t[$k]}
  done
}

# mix_hex <#a> <#b> <percent>: a with percent of b mixed in
mix_hex() {
  local a=${1#\#} b=${2#\#} p=$3 i x y out="#"
  for i in 0 2 4; do
    x=$((16#${a:i:2}))
    y=$((16#${b:i:2}))
    out+=$(printf '%02x' $(((x * (100 - p) + y * p + 50) / 100)))
  done
  printf '%s' "$out"
}

# One filter step. Color steps: lighten:N, darken:N (N percent of white or black mixed in),
# mix:<key>:N (another palette color). Formats, last in a chain: bare (5d6fe8),
# rgb (93,111,232), argb (#ff5d6fe8), alpha:XX (#5d6fe8XX, XX in hex).
color_step() {
  local v=$1 f=$2 h n
  h=${v#\#}
  [[ $v =~ ^#[0-9a-fA-F]{6}$ ]] || return 1
  case $f in
    bare) printf '%s' "$h" ;;
    argb) printf '#ff%s' "$h" ;;
    rgb) printf '%d,%d,%d' "$((16#${h:0:2}))" "$((16#${h:2:2}))" "$((16#${h:4:2}))" ;;
    alpha:*)
      [[ ${f#alpha:} =~ ^[0-9a-fA-F]{2}$ ]] || return 1
      printf '%s%s' "$v" "${f#alpha:}" ;;
    lighten:* | darken:*)
      n=${f#*:}
      [[ $n =~ ^[0-9]+$ ]] && ((n <= 100)) || return 1
      if [[ $f == lighten:* ]]; then mix_hex "$v" "#ffffff" "$n"; else mix_hex "$v" "#000000" "$n"; fi ;;
    mix:*)
      local rest=${f#mix:} key
      key=${rest%:*}
      n=${rest##*:}
      [[ -n ${PALETTE[$key]+set} && $n =~ ^[0-9]+$ ]] && ((n <= 100)) || return 1
      mix_hex "$v" "${PALETTE[$key]}" "$n" ;;
    *) return 1 ;;
  esac
}

# apply_filters <value> <"|step|step">
apply_filters() {
  local value=$1 chain=$2 f
  local IFS='|'
  for f in $chain; do
    f=${f// /}
    [[ -z $f ]] && continue
    value=$(color_step "$value" "$f") || return 1
  done
  printf '%s' "$value"
}

# Prints a template with every {{key}} or {{key|step|step}} filled in
render_template() {
  local file=$1 line out match key chain value
  local re='\{\{ *([A-Za-z0-9_.]+) *((\| *[A-Za-z0-9:._]+ *)*)\}\}'
  while IFS= read -r line || [[ -n $line ]]; do
    out=""
    while [[ $line =~ $re ]]; do
      match=${BASH_REMATCH[0]} key=${BASH_REMATCH[1]} chain=${BASH_REMATCH[2]}
      if [[ -z ${PALETTE[$key]+set} ]]; then
        printf 'unknown key %s in %s\n' "$key" "${file#"$TEMPLATE_DIR"/}" >&2
        return 1
      fi
      if ! value=$(apply_filters "${PALETTE[$key]}" "$chain"); then
        printf 'bad filter "%s" on %s in %s\n' "$chain" "$key" "${file#"$TEMPLATE_DIR"/}" >&2
        return 1
      fi
      out+="${line%%"$match"*}$value"
      line=${line#*"$match"}
    done
    printf '%s\n' "$out$line"
  done <"$file"
}

# Every installed module's templates: "<module> TAB <path>", the path relative to
# <module>/templates, which is also where the file goes inside the module
# Before the styles, the app themes facet theme wrote were called frameshell; they would still
# be linked (fish would load two color files). Also links to files a module no longer has.
prune_old_outputs() {
  local f
  for f in \
    zed/zed/.config/zed/themes/frameshell.json \
    terminal/fish/.config/fish/conf.d/frameshell-colors.fish \
    terminal/ghostty/.config/ghostty/themes/frameshell \
    spotify/spicetify/.config/spicetify/Themes/Frameshell \
    discord/vencord/.config/vesktop/themes/frameshell.theme.css \
    steam/steam/.local/share/Steam/millennium/themes/Frameshell \
    dolphin/dolphin/.config/qt6ct/colors/Frameshell.conf \
    dolphin/dolphin/.local/share/color-schemes/Frameshell.colors; do
    [[ -e $MODULES_DIR/$f ]] && run rm -rf "${MODULES_DIR:?}/$f"
  done
  ((DRY_RUN)) && return 0
  find "$HOME/.config" "$HOME/.local/bin" "$HOME/.local/share" -maxdepth 8 -xtype l \
    -lname '*frameshell/modules/*' -delete 2>/dev/null || true
}

# Prints "module <tab> template path <tab> output path": a style module's templates while that
# style is in use or gives the login and boot screens; in every other module the ones under
# templates/<style in use>/ (written without that folder) and the ones not under any style
theme_templates() {
  local m dir style screens styles rel first
  style=$(current_style) screens=$(screens_style)
  styles=" $(style_names | tr '\n' ' ') "
  while IFS= read -r m; do
    dir="$(module_dir "$m")/templates"
    [[ -d $dir ]] || continue
    if [[ $m == style-* ]]; then
      [[ $m == "style-$style" || $m == "style-$screens" ]] || continue
      (cd "$dir" && find . -type f | sed 's|^\./||' | sort) | while IFS= read -r rel; do
        printf '%s\t%s\t%s\n' "$m" "$rel" "$rel"
      done
      continue
    fi
    (cd "$dir" && find . -type f | sed 's|^\./||' | sort) | while IFS= read -r rel; do
      first=${rel%%/*}
      if [[ $styles == *" $first "* ]]; then
        [[ $first == "$style" ]] && printf '%s\t%s\t%s\n' "$m" "$rel" "${rel#*/}"
      else
        printf '%s\t%s\t%s\n' "$m" "$rel" "$rel"
      fi
    done
  done < <(installed_modules)
}

# theme_render <name> <check: 0|1> [quiet]: writes (or only compares) every output file
theme_render() {
  local id=$1 check=$2 quiet=${3:-}
  if ! command -v jq >/dev/null; then
    if ((DRY_RUN)); then
      info "would write the $id color files (needs jq)"
      return 0
    fi
    die "facet theme needs jq" "install it: sudo pacman -S jq"
  fi
  load_palette "$id"
  [[ -n $quiet ]] || step "Theme ${PALETTE[name]} (themes/$(current_style)/$id.json)"

  local m rel base pkg tmp state mark color written=0 stale=0 total=0
  tmp="$(mktemp)"
  local src
  while IFS=$'\t' read -r m src rel; do
    total=$((total + 1))
    base=$(module_dir "$m")
    pkg=${rel%%/*}
    TEMPLATE_DIR="$base/templates"
    if ! render_template "$TEMPLATE_DIR/$src" >"$tmp"; then
      rm -f "$tmp"
      die "Could not render $m/templates/$src" "fetch the module again: facet update $m"
    fi
    if [[ -f $base/$rel ]] && cmp -s "$tmp" "$base/$rel"; then
      state=unchanged color=$c_ok mark=✓
    elif ((check)); then
      state="out of date" color=$c_warn mark=! stale=$((stale + 1))
    else
      run mkdir -p "$(dirname "$base/$rel")"
      run cp "$tmp" "$base/$rel"
      state=written color=$c_warn mark=↻ written=$((written + 1))
    fi
    [[ -n $quiet ]] || printf '  %s%s%s %-11s %-50s %s%s%s\n' "$color" "$mark" "$c_reset" "$pkg" "${rel#*/}" "$c_muted" "$state" "$c_reset"
    # Outputs must stay out of git, or every theme switch would be a change in the module
    if ((!check)) && [[ -d $base/.git ]] && command -v git >/dev/null \
      && ! git -C "$base" check-ignore -q -- "$rel" 2>/dev/null; then
      warn "$m/$rel is not in .gitignore"
    fi
  done < <(theme_templates)
  rm -f "$tmp"

  if ((check)); then
    if ((stale)); then
      warn "$stale of $total files do not match themes/$(current_style)/$id.json, run: facet theme"
      exit 1
    fi
    info "All $total files match themes/$(current_style)/$id.json"
  elif [[ -n $quiet ]]; then
    ok "Theme ${PALETTE[name]}: $total color files, $written rewritten"
  else
    info "$written of $total files rewritten"
  fi
}

# What each app needs after its color files changed; only for linked packages
theme_reload() {
  step "Apps"
  local p
  for p in $(installed_packages); do
    case $p in
      quickshell | tui | bloom) ok "Quickshell reloads on its own" ;;
      hypr)
        if command -v hyprctl >/dev/null && ((!DRY_RUN)); then
          hyprctl reload >/dev/null 2>&1 && ok "Hyprland window colors reloaded"
        fi
        ;;
      spicetify) post_spicetify ;;
      ghostty) info "Ghostty: new windows use the theme, open ones reload with Ctrl+Shift+," ;;
      fish) info "fish and Starship: new shells use the theme" ;;
      vencord) info "Vesktop: reload with Ctrl+R if the colors did not change on their own" ;;
      gtk) info "GTK apps (file dialogs, Nautilus, pavucontrol): restart them for the new colors" ;;
      zed) ok "Zed reloads its theme on its own" ;;
      dolphin) info "Dolphin: restart it for the new colors" ;;
      zen) info "Zen: restart it for the new colors" ;;
      keyboard) keyboard_theme ;;
      steam)
        steam_css
        info "Steam: restart it for the new colors"
        ;;
    esac
  done
  if command -v curl >/dev/null && [[ -n $(goxlr_serial) ]]; then
    goxlr_lighting "${PALETTE[id]}" quiet
  fi
  if [[ -d $GRUB_THEME_DIR ]]; then
    info "Boot menu: run facet grub to give GRUB the new colors (needs sudo)"
  fi
  if [[ -d $PLYMOUTH_DIR || -f $VTRGB_FILE ]]; then
    info "Boot splash and consoles: run facet boot for the new colors (needs sudo, rebuilds the initramfs)"
  fi
  # The login screen keeps its own copy of the theme in /usr/share
  if [[ -d $GREETER_DIR ]] && ((!DRY_RUN)); then
    if sudo -n install -D -m 644 "$(screens_theme_file)" "$GREETER_DIR/$(greeter_theme_dest)" 2>/dev/null; then
      ok "Login screen colors updated"
    else
      info "Login screen: run facet login to give it the new colors (needs sudo)"
    fi
  fi
  return 0
}

theme_list() {
  header
  step "Themes"
  local id cur desc swatch r h
  cur=$(current_theme)
  for id in $(theme_ids); do
    desc=$(sed -n 's/.*"description": *"\([^"]*\)".*/\1/p' "$(themes_dir)/$id.json" | head -n 1)
    swatch=$(theme_swatch "$id")
    if [[ $id == "$cur" ]]; then
      printf '  %s❯%s %s%-11s%s %s%s%s%s\n' "$c_primary" "$c_reset" "$c_bold" "$id" "$c_reset" "$swatch" "$c_muted" "$desc" "$c_reset"
    else
      printf '    %-11s %s%s%s%s\n' "$id" "$swatch" "$c_muted" "$desc" "$c_reset"
    fi
  done
  info "Switch with: facet theme set <name>"
}

# facet theme set without a name: every theme with its colors, the active one selected
theme_pick() {
  local id desc i=0 start=0 cur opts=()
  cur=$(current_theme)
  for id in $(theme_ids); do
    desc=$(sed -n 's/.*"description": *"\([^"]*\)".*/\1/p' "$(themes_dir)/$id.json" | head -n 1)
    [[ $id == "$cur" ]] && start=$i
    opts+=("$id|$(theme_swatch "$id")$c_muted$desc$c_reset")
    i=$((i + 1))
  done
  theme_previews
  menu "Which theme? (now: $cur)" "$start" "${opts[@]}"
}

theme_set() {
  local id=$1
  is_theme "$id" || die "Unknown theme: $id" "$(did_you_mean "$id" $(theme_ids))themes: $(theme_ids | tr '\n' ' ')"
  # Check before saving, so the saved theme never differs from the written files
  command -v jq >/dev/null || ((DRY_RUN)) || die "facet theme needs jq" "install it: sudo pacman -S jq"
  header
  save_theme "$id"
  theme_render "$id" 0
  theme_reload
  printf '\n%sDone.%s frameshell now uses %s.\n\n' "$c_ok" "$c_reset" "${PALETTE[name]:-$id}"
}

cmd_theme() {
  local action=${1:-}
  case $action in
    "")
      header
      theme_render "$(current_theme)" 0
      theme_reload
      ;;
    list | ls) theme_list ;;
    set | use | pick)
      if [[ -n ${2:-} ]]; then
        theme_set "$2"
      elif [[ -t 0 && -t 2 ]]; then
        local picked
        picked=$(theme_pick) || exit 0
        theme_set "$picked"
      else
        die "Which theme?" "name it: facet theme set <name> (all of them: facet theme list)"
      fi
      ;;
    check)
      header
      theme_render "$(current_theme)" 1
      ;;
    *)
      # facet theme sakura works too
      if is_theme "$action"; then
        theme_set "$action"
      else
        die "Unknown theme or action: $action" "$(did_you_mean "$action" list set check $(theme_ids))facet theme list, set <name> or check"
      fi
      ;;
  esac
}

# ── Small PNGs for GRUB ──────────────────────────────────────
# GRUB draws the menu frame from 1px images. They only need one color each, so they
# are written here directly (stored deflate block, no compression) instead of
# depending on an image tool.

CRC_TABLE=()
crc_init() {
  local n c k
  ((${#CRC_TABLE[@]})) && return 0
  for ((n = 0; n < 256; n++)); do
    c=$n
    for ((k = 0; k < 8; k++)); do
      if ((c & 1)); then c=$((0xEDB88320 ^ (c >> 1))); else c=$((c >> 1)); fi
    done
    CRC_TABLE[n]=$c
  done
}

# CRC-32 of hex-encoded bytes, as 8 hex digits
crc32_hex() {
  local hex=$1 c=0xFFFFFFFF i
  crc_init
  for ((i = 0; i < ${#hex}; i += 2)); do
    c=$((CRC_TABLE[(c ^ 16#${hex:i:2}) & 0xFF] ^ (c >> 8)))
  done
  printf '%08x' $((c ^ 0xFFFFFFFF))
}

adler32_hex() {
  local hex=$1 a=1 b=0 i
  for ((i = 0; i < ${#hex}; i += 2)); do
    a=$(((a + 16#${hex:i:2}) % 65521))
    b=$(((b + a) % 65521))
  done
  printf '%04x%04x' "$b" "$a"
}

png_chunk() {
  local type=$1 data=$2
  printf '%08x%s%s%s' $((${#data} / 2)) "$type" "$data" "$(crc32_hex "$type$data")"
}

# png_solid <file> <width> <rrggbb>: one row of opaque pixels in one color
png_solid() {
  local file=$1 width=$2 color=$3 raw="00" i len zlib hex bytes=""
  if ((DRY_RUN)); then
    info "would draw ${file##*/} (${width}x1, #$color)"
    return 0
  fi
  for ((i = 0; i < width; i++)); do raw+="${color}ff"; done
  len=$((${#raw} / 2))
  # zlib header, one final stored block (LEN and its complement, little endian), Adler-32
  zlib="780101$(printf '%02x%02x%02x%02x' $((len & 255)) $((len >> 8)) $((~len & 255)) $(((~len >> 8) & 255)))$raw$(adler32_hex "$raw")"
  hex="89504e470d0a1a0a"
  hex+=$(png_chunk 49484452 "$(printf '%08x%08x' "$width" 1)0806000000")
  hex+=$(png_chunk 49444154 "$zlib")
  hex+=$(png_chunk 49454e44 "")
  for ((i = 0; i < ${#hex}; i += 2)); do bytes+="\\x${hex:i:2}"; done
  printf '%b' "$bytes" >"$file"
}

