# The launcher's Spotify bridge (s mode): the frameshell extension plus a token only the
# shell and the client know (frameshell-token.js), so no web page can pose as Spotify.
# Without it the launcher falls back to frame-spotify and MPRIS.
spotify_bridge() {
  local token_file="$STATE_DIR/spotify-bridge.token"
  local token_js="$HOME/.config/spicetify/Extensions/frameshell-token.js"
  if ((DRY_RUN)); then
    info "would write the bridge token to $token_file and $token_js"
  else
    mkdir -p "$STATE_DIR" "$(dirname "$token_js")"
    if [[ ! -s $token_file ]]; then
      (umask 077 && od -An -tx1 -N24 /dev/urandom | tr -d ' \n' >"$token_file")
    fi
    printf 'window.FRAMESHELL_TOKEN = "%s";\n' "$(cat "$token_file")" >"$token_js"
  fi
  run spicetify config extensions frameshell-token.js
  run spicetify config extensions frameshell.js
}

# The theme folder and color scheme of the style in use (Themes/<style>, [<style>])
select_spicetify() {
  command -v spicetify >/dev/null || ((DRY_RUN)) || return 0
  run spicetify config current_theme "$(current_style)" color_scheme "$(current_style)"
}

# Spotify updates wipe spicetify's changes, so this runs on every update
post_spicetify() {
  if ! command -v spicetify >/dev/null && ((!DRY_RUN)); then
    warn "spicetify not found, skipping theme activation"
    return 0
  fi
  select_spicetify
  spotify_bridge

  # The AUR Spotify sits in /opt/spotify, owned by root; spicetify has to write there
  if [[ -d /opt/spotify && ! -w /opt/spotify ]]; then
    info "Spotify in /opt/spotify is not writable for you, spicetify needs that"
    if confirm "Allow it (sudo chmod a+wr on /opt/spotify, as spicetify's docs say)?"; then
      run sudo chmod a+wr /opt/spotify && run sudo chmod -R a+wr /opt/spotify/Apps
    fi
  fi

  # apply fails on a fresh install (no backup yet: backup apply) or after a Spotify update (the
  # backup is outdated and backup apply refuses: restore backup apply, as spicetify says)
  # The quiet first tries avoid spicetify's "you haven't backed up" error on a fresh install
  if task "Applying the Spotify theme" "Spotify theme applied" \
    bash -c 'spicetify apply >/dev/null 2>&1 || spicetify backup apply >/dev/null 2>&1 || spicetify restore backup apply'; then
    return 0
  fi
  warn "spicetify failed"
  hint "open Spotify once, log in, close it, then: facet update spotify"
  info "Still broken after a Spotify update? Try: spicetify restore backup apply"
  info "Spotify from the AUR may need write access: https://spicetify.app/docs/advanced-usage/installation#spotify-installed-from-aur"
}

# jq in place: json_edit <file> [jq options…] <filter>
json_edit() {
  local file=$1 tmp
  shift
  tmp="$(mktemp)"
  jq "$@" "$file" >"$tmp" && mv "$tmp" "$file"
}

# Vesktop shows the theme of the style in use: <style>.theme.css on, the other styles' off
select_vencord() {
  local vencord="${XDG_CONFIG_HOME:-$HOME/.config}/vesktop/settings/settings.json"
  [[ -f $vencord ]] && command -v jq >/dev/null || return 0
  if ((DRY_RUN)); then
    info "would turn on $(current_style).theme.css in $vencord"
    return 0
  fi
  json_edit "$vencord" --arg t "$(current_style).theme.css" \
    '.enabledThemes = (((.enabledThemes // []) | map(select(test("^(frameshell|tui|bloom)\\.theme\\.css$") | not))) + [$t])'
}

# ── Vencord build with the ShellBridge plugin ────────────────
# Vesktop ships its own Vencord, but user plugins need a self-built one. frame keeps a
# clone in ~/.local/share/frameshell/vencord and rebuilds only when Vencord or the
# plugin changed.

vencord_plugin_hash() {
  (cd "$(pkg_dir vencord)/plugins" && find shellBridge -type f -print0 | sort -z | xargs -0 sha1sum) | sha1sum | cut -c1-12
}

vencord_build() {
  info "Vencord with ShellBridge"
  if [[ -d $VENCORD_SRC/.git ]]; then
    task "Updating Vencord" "" git -C "$VENCORD_SRC" pull --ff-only --quiet \
      || warn "Could not update Vencord, building the version that is there"
  else
    run mkdir -p "$(dirname "$VENCORD_SRC")"
    task "Getting Vencord (first time only)" "Vencord downloaded" \
      git clone --depth 1 --quiet https://github.com/Vendicated/Vencord.git "$VENCORD_SRC"
  fi

  local marker="$STATE_DIR/vencord-build" wanted=""
  [[ -d $VENCORD_SRC/.git ]] && wanted="$(git -C "$VENCORD_SRC" rev-parse --short HEAD)-$(vencord_plugin_hash)"
  if [[ -n $wanted && -d $VENCORD_SRC/dist && -f $marker && "$(cat "$marker")" == "$wanted" ]]; then
    ok "Vencord build up to date"
    return 0
  fi

  run rm -rf "$VENCORD_SRC/src/userplugins/shellBridge"
  run mkdir -p "$VENCORD_SRC/src/userplugins"
  run cp -r "$(pkg_dir vencord)/plugins/shellBridge" "$VENCORD_SRC/src/userplugins/shellBridge"
  if task "Getting Vencord's build tools" "" pnpm -C "$VENCORD_SRC" install --frozen-lockfile --silent \
    && task "Building Vencord, about a minute" "" pnpm -C "$VENCORD_SRC" build; then
    # A build that silently left the plugin out is worse than a failed one
    if ((!DRY_RUN)) && ! grep -q "shellbridge-watch" "$VENCORD_SRC/dist/vencordDesktopRenderer.js" 2>/dev/null; then
      warn "The Vencord build does not contain ShellBridge; run: facet update vencord"
      return 1
    fi
    if ((!DRY_RUN)); then
      mkdir -p "$STATE_DIR"
      echo "$wanted" >"$marker"
    fi
    ok "Vencord built with ShellBridge"
    # Vesktop only loads dist/; the build tools are several hundred MB and come back with
    # the next build that needs them
    run rm -rf "$VENCORD_SRC/node_modules"
    run_quiet pnpm store prune || true
    ok "Build tools removed again (dist/ stays)"
  else
    warn "Vencord build failed, Vesktop keeps its own Vencord (the theme still works)"
    hint "try again later: facet update discord"
    return 1
  fi
}

# Builds Vencord with ShellBridge, points Vesktop at it and turns on theme and plugin.
# Vesktop has to be closed while its settings are written, otherwise it writes its own
# copy back on exit.
post_vencord() {
  local built=0
  if command -v pnpm >/dev/null || ((DRY_RUN)); then
    vencord_build && built=1
  else
    warn "pnpm not found, skipping the ShellBridge plugin (the theme still works)"
  fi

  local vesktop="$HOME/.config/vesktop/state.json"
  local vencord="$HOME/.config/vesktop/settings/settings.json"
  if [[ ! -f $vencord ]]; then
    info "Start Vesktop once, close it, then run: facet update vencord"
    return 0
  fi
  if command -v pgrep >/dev/null && pgrep -fi vesktop >/dev/null; then
    warn "Vesktop is running. Close it and run: facet update vencord"
    return 0
  fi
  if ((DRY_RUN)); then
    info "would enable the theme and ShellBridge in $vencord"
    info "would set the Vencord location in $vesktop to $VENCORD_SRC/dist"
    return 0
  fi
  if ! command -v jq >/dev/null; then
    warn "jq not found, enable it by hand: Settings → Themes → facet $(current_style), Plugins → ShellBridge"
    return 0
  fi

  select_vencord
  ok "Theme enabled"
  if ((built)) || [[ -d $VENCORD_SRC/dist ]]; then
    json_edit "$vencord" '.plugins.ShellBridge.enabled = true'
    [[ -f $vesktop ]] || echo '{}' >"$vesktop"
    # Vesktop's "Vencord location": the dist folder of the build
    # Vesktop keeps "Vencord location" in state.json (not settings.json)
    json_edit "$vesktop" --arg dir "$VENCORD_SRC/dist" '.vencordDir = $dir'
    ok "ShellBridge enabled, Vesktop uses the frameshell Vencord build"
    info "Start Vesktop to load it"
  fi
  return 0
}

# Millennium reaches Steam through a link its package writes into Steam's runtime at install
# time. Installed before Steam's first start (as facet install does on a new machine), that
# folder does not exist yet and Steam runs without Millennium: no theme, no plugin.
MILLENNIUM_BOOTSTRAP=/usr/lib/millennium/libmillennium_bootstrap_x86.so
millennium_hook_missing() {
  local hook="$HOME/.local/share/Steam/ubuntu12_32/libXtst.so.6"
  [[ -f $MILLENNIUM_BOOTSTRAP && -d ${hook%/*} ]] || return 1
  [[ $(readlink -f "$hook" 2>/dev/null) != "$MILLENNIUM_BOOTSTRAP" ]]
}

millennium_hook() {
  millennium_hook_missing || return 0
  local hook="$HOME/.local/share/Steam/ubuntu12_32/libXtst.so.6"
  if command -v pgrep >/dev/null && pgrep -x steam >/dev/null; then
    warn "Millennium is not hooked into Steam yet; close Steam and run: facet update steam"
    return 0
  fi
  # The same two steps as the package's install script
  run ln -sfn "$MILLENNIUM_BOOTSTRAP" "$hook"
  run touch "$HOME/.steam/steam/.cef-enable-remote-debugging"
  ok "Millennium hooked into Steam's runtime (start Steam to load it)"
}

# Steam's library and settings pages use hashed class names and literal colors, so the
# theme cannot name them: frame-steam-css (steam package) reads the installed Steam's CSS
# and writes generated.css with those classes in the theme's colors
steam_css() {
  local bin="$HOME/.local/bin/frame-steam-css"
  [[ -x $bin && -f $HOME/.local/share/Steam/steamui/css/sp.css ]] || return 0
  if run_quiet "$bin"; then
    ok "Steam: library colors generated from Steam's own CSS (frame-steam-css)"
  else
    warn "Steam: frame-steam-css failed, the library keeps Steam's colors"
  fi
}

# Millennium: the style's theme (themes/<style>) and the frameshell plugin, which moves Steam's
# notifications into the shell. A running Steam gets both over Millennium's steam://
# links; otherwise they go into Millennium's config.json (only while Steam is closed,
# it writes its own copy back).
# The Millennium theme of the style in use, for facet style (Steam running or not)
select_steam() {
  local config="${XDG_CONFIG_HOME:-$HOME/.config}/millennium/config.json"
  steam_css
  if command -v pgrep >/dev/null && pgrep -x steam >/dev/null; then
    run_quiet steam "steam://millennium/settings/themes/enable/$(current_style)" || true
  elif [[ -f $config ]] && command -v jq >/dev/null && ((!DRY_RUN)); then
    json_edit "$config" --arg t "$(current_style)" '.themes.activeTheme = $t'
  fi
  return 0
}

post_steam() {
  local config="${XDG_CONFIG_HOME:-$HOME/.config}/millennium/config.json" steam_dir
  steam_css

  # Millennium reads themes from ~/.steam/steam/millennium/themes; the package links into
  # ~/.local/share/Steam, where that points on Arch. Another Steam folder gets a link.
  steam_dir="$(readlink -f "$HOME/.steam/steam" 2>/dev/null || true)"
  if [[ -n $steam_dir && -d $steam_dir && $steam_dir != "$(readlink -f "$HOME/.local/share/Steam" 2>/dev/null)" ]]; then
    local theme target
    for theme in "$(pkg_dir steam)"/.local/share/Steam/millennium/themes/*/; do
      theme=${theme%/}
      target="$steam_dir/millennium/themes/${theme##*/}"
      if [[ -e $target && ! -L $target ]]; then
        warn "$target exists and is not a link, leaving it alone"
        continue
      fi
      info "Steam lives in $steam_dir, linking the ${theme##*/} theme there too"
      run mkdir -p "$steam_dir/millennium/themes"
      run ln -sfn "$theme" "$target"
    done
    # The theme was called Frameshell before the styles
    [[ -L $steam_dir/millennium/themes/Frameshell ]] && run rm -f "$steam_dir/millennium/themes/Frameshell"
  fi

  if ! has_pkg millennium && ! has_pkg millennium-bin && ((!DRY_RUN)); then
    warn "Millennium is not installed, Steam stays as it is (paru -S millennium)"
    return 0
  fi
  millennium_hook

  if command -v pgrep >/dev/null && pgrep -x steam >/dev/null; then
    # The plugin link reloads Steam's UI
    run_quiet steam "steam://millennium/settings/themes/enable/$(current_style)"
    run_quiet steam steam://millennium/settings/plugins/enable/frameshell
    ok "Theme and plugin turned on in the running Steam"
    return 0
  fi
  if [[ ! -f $config ]]; then
    info "Start Steam once so Millennium writes its settings, close it, then run: facet update steam"
    return 0
  fi
  if ((DRY_RUN)); then
    info "would set the theme to $(current_style) and enable the frameshell plugin in $config"
    return 0
  fi
  if ! command -v jq >/dev/null; then
    warn "jq not found, turn it on by hand: Steam → Millennium → Themes → facet $(current_style), Plugins → frameshell"
    return 0
  fi

  json_edit "$config" --arg t "$(current_style)" '.themes.activeTheme = $t
    | .plugins.enabledPlugins = ((.plugins.enabledPlugins // []) + ["frameshell"] | unique)'
  ok "Theme and plugin enabled, start Steam to load them"
  return 0
}

# ini_set <file> <section> <key> <value>: sets one key in an INI file (KDE, qt6ct),
# adds the section or key when missing and leaves everything else alone
ini_set() {
  local file=$1 section=$2 key=$3 value=$4 tmp
  if ((DRY_RUN)); then
    info "would set [$section] $key=$value in ${file/#"$HOME"/\~}"
    return 0
  fi
  mkdir -p "$(dirname "$file")"
  [[ -f $file ]] || : >"$file"
  tmp="$(mktemp)"
  # Blank lines are held back, so a new key lands before the gap to the next section
  awk -v s="[$section]" -v k="$key" -v v="$value" '
    function emit() { if (insec && !done) { print k "=" v; done = 1 } }
    function flush() { while (blank > 0) { print ""; blank-- } }
    /^[[:space:]]*$/ { blank++; next }
    /^\[/ { emit(); flush(); insec = ($0 == s); if (insec) seen = 1; print; next }
    insec && index($0, k "=") == 1 { flush(); if (!done) { print k "=" v; done = 1 }; next }
    { flush(); print }
    END { emit(); flush(); if (!seen) { if (NR) print ""; print s; print k "=" v } }
  ' "$file" >"$tmp"
  cat "$tmp" >"$file"
  rm -f "$tmp"
}

# set_default_app <desktop file> <mime type...>
