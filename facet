#!/usr/bin/env bash
# facet – install and manage facet, a desktop for CachyOS + Hyprland
#
#   facet                        in a terminal: a menu of the commands below
#   facet install [module...]    the setup (no names), or just these modules
#   facet add [module...]        fetch and set up a module later (no names: pick from a list)
#   facet update  [module...]    pull the CLI and the modules, back up, relink, re-apply themes
#   facet remove  [module...]    unlink a module and delete it (no names: pick from a list)
#   facet backup  [package...]   snapshot the current configs and app settings
#   facet restore [name|latest]  list backups, or put one back
#   facet theme [list|set <name>|check]
#                                write every app color file from themes/<name>.json
#   facet grub [install|remove]  theme the GRUB boot menu (copies to /boot, needs sudo)
#   facet boot [install|check|remove] boot splash (Plymouth) and text console colors in the theme
#   facet goxlr                  light the GoXLR in the theme's colors (goxlr-utility)
#   facet audio channels on|off  virtual sound channels (System, Game, Chat, Music) without a GoXLR;
#                                also: output <sink>, status
#   facet add keyboard           frame-keyboard, its udev rules (sudo), the Super+K app; asks which keyboard
#   facet keyboard [list|search <text>|set [board]|request]
#                                the supported keyboards, and which one is yours
#   facet login [install|auto|remove] the lockscreen look as the login screen, or straight into Hyprland (greetd, needs sudo)
#   facet wallpaper <args…>      passed to frame-wallpaper (backend, set, apply, …)
#   facet spotify <args…>        passed to frame-spotify (login, logout, status)
#   facet style [name|list]      the look of the whole desktop: tui or bloom (theme is the colors)
#   facet layout [tiling|canvas] Hyprland tiling or the infinite canvas
#   facet status                 show what is linked and what is missing
#   facet clean                  free disk space: caches, orphans, old backups, logs
#
# Options: -n/--dry-run (print what would happen), -y/--yes (no questions),
#          -v/--verbose (the full output of long commands instead of a spinner)

set -euo pipefail

REPO="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/frameshell"
BACKUP_ROOT="$STATE_DIR/backup"
GRUB_THEME_DIR="/boot/grub/themes/frameshell"
GRUB_DEFAULT_FILE="/etc/default/grub"
VENCORD_SRC="${XDG_DATA_HOME:-$HOME/.local/share}/frameshell/vencord"

# ── Modules ──────────────────────────────────────────────────
# facet is split into repos (github.com/facet-shell): this CLI with the themes, and one
# repo per module. Only the modules you pick are cloned (shallow) into MODULES_DIR; each
# holds one or more Stow packages plus templates/ for the files with colors. core is what
# every style shares (services, bridges, config, Hyprland, wallpapers); a style (style-tui, style-bloom)
# is the bar, panels and popups on top, linked into the same folders (--no-folding).
ORG_URL="${FACET_ORG_URL:-https://github.com/facet-shell}"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/frameshell"
MODULES_DIR="$DATA_DIR/modules"
# Your own pictures (fastfetch logo, wallpapers); never part of a repo
ASSETS_DIR="$DATA_DIR/assets"

MODULES=(core style-tui style-bloom terminal spotify discord steam keyboard zed zen dolphin)
declare -A MODULE_OF=(
  [quickshell]=core [hypr]=core [wallpaper]=core
  [tui]=style-tui [gtk]=style-tui
  [bloom]=style-bloom
  [ghostty]=terminal [fish]=terminal [starship]=terminal [fastfetch]=terminal
  [spicetify]=spotify [vencord]=discord [steam]=steam [keyboard]=keyboard
  [zed]=zed [zen]=zen [dolphin]=dolphin
)
declare -A MODULE_DESC=(
  [core]="what every style shares: services and bridges, settings, Hyprland config, wallpapers"
  [style-tui]="the tui style: bar, launcher, lockscreen and panels in square frames, login and boot screens"
  [style-bloom]="the bloom style: a rounded frame around the screen, panels sliding out of it, Material You colors"
  [terminal]="Ghostty, fish, Starship, fastfetch"
  [spotify]="Spotify themed, search and controls in the launcher"
  [discord]="Vesktop themed, calls and DMs in the shell"
  [steam]="Steam themed through Millennium, its popups in the shell"
  [keyboard]="keyboard lighting and keys (AULA F75, F65, F99, Womier L65 and more)"
  [zed]="Zed themed"
  [zen]="Zen themed, with the start page"
  [dolphin]="Dolphin and Qt apps themed"
)

module_dir() { echo "$MODULES_DIR/$1"; }
# A package's folder inside its module
pkg_dir() { echo "$MODULES_DIR/${MODULE_OF[$1]}/$1"; }
has_module() { [[ -d $MODULES_DIR/$1/.git ]]; }
installed_modules() {
  local m
  for m in "${MODULES[@]}"; do has_module "$m" && echo "$m"; done
  return 0
}
is_module() {
  local m
  for m in "${MODULES[@]}"; do [[ $m == "$1" ]] && return 0; done
  return 1
}
# Packages of a module, in PACKAGES order
module_packages() {
  local p
  for p in "${PACKAGES[@]}"; do [[ ${MODULE_OF[$p]} == "$1" ]] && echo "$p"; done
  return 0
}

# The style in use (tui or bloom): its module holds the bar, panels and popups as the package
# of the same name, and the login and boot screens
STYLE_STATE="$STATE_DIR/style"
current_style() {
  local style=tui
  [[ -f $STYLE_STATE ]] && read -r style <"$STYLE_STATE"
  echo "${style:-tui}"
}

# The style whose login screen, boot splash and GRUB menu are used: the one in use, or tui
# while that one has none of its own yet (bloom for now). Fetched when it is not there.
screens_style() {
  local style
  style=$(current_style)
  [[ -d $(module_dir "style-$style")/greeter ]] || style=tui
  echo "$style"
}
screens_dir() {
  local style
  style=$(screens_style)
  has_module "style-$style" || ensure_module "style-$style" >&2
  module_dir "style-$style"
}
screens_theme_file() { echo "$(pkg_dir "$(screens_style)")/.config/quickshell/config/Theme.qml"; }

# A style's greeter that lists its files (greeter/files: "<destination> <source>" per line;
# greeter/… from the style's folder, package/… from its Quickshell package, theme the
# rendered Theme.qml). tui's greeter has no list and is installed the old way.
greeter_has_manifest() { [[ -f $(screens_dir)/greeter/files ]]; }
greeter_install_manifest() {
  local src pkg dest from mode
  src=$(screens_dir) pkg="$(pkg_dir "$(screens_style)")/.config/quickshell"
  run sudo install -d -m 755 "$GREETER_DIR"
  # What the other style left there
  run sudo rm -rf "$GREETER_DIR/ui" "$GREETER_DIR/config" "$GREETER_DIR/components" "$GREETER_DIR/lockscreen"
  while read -r dest from; do
    [[ -z $dest || $dest == \#* ]] && continue
    case $from in
      theme) from=$(screens_theme_file) ;;
      greeter/*) from=$src/$from ;;
      package/*) from=$pkg/${from#package/} ;;
    esac
    mode=644
    [[ $dest == frame-greeter-session ]] && mode=755
    run sudo install -D -m "$mode" "$from" "$GREETER_DIR/$dest"
  done <"$src/greeter/files"
}
# Where the login screen keeps its copy of the theme
greeter_theme_dest() {
  if greeter_has_manifest; then
    awk '$2 == "theme" { print $1; exit }' "$(screens_dir)/greeter/files"
  else
    echo ui/Theme.qml
  fi
}

# The UI font of the style in use: tui is all JetBrains Mono, bloom's text is Rubik
style_ui_font() {
  case $(current_style) in
    bloom) echo Rubik ;;
    *) echo "JetBrains Mono" ;;
  esac
}

# Before facet, core and the tui style were one module called shell. Its links go, the
# folder becomes core (the repo was renamed on GitHub), the tui style is fetched next to it;
# what was linked before is linked again by the caller (facet update, facet install).
# Prints the packages that were linked, nothing when there was nothing to move.
migrate_shell_module() {
  local old new f pkgs=()
  old=$(module_dir shell) new=$(module_dir core)
  [[ -d $old/.git && ! -e $new ]] || return 0
  if ((DRY_RUN)); then
    info "would move the shell module to core and style-tui" >&2
    return 0
  fi
  info "The shell module is core and style-tui now; moving it over" >&2
  for f in quickshell hypr wallpaper gtk; do
    [[ -n $(find "$HOME/.config" "$HOME/.local/bin" "$HOME/.local/share/applications" -type l -lname "*modules/shell/$f/*" -print -quit 2>/dev/null) ]] && pkgs+=("$f")
  done
  # Links into the old folder, also the ones whose file is no longer in the repo
  find "$HOME/.config" "$HOME/.local/bin" "$HOME/.local/share/applications" -type l -lname "*modules/shell/*" -delete 2>/dev/null || true
  mv "$old" "$new"
  git -C "$new" remote set-url origin "$ORG_URL/core.git"
  git -C "$new" pull --ff-only --quiet || warn "Could not pull core; facet update tries again" >&2
  # Written by facet theme into the old module; the tui style has its own now
  rm -rf "$new/quickshell/.config/quickshell/config/Theme.qml" "$new/gtk" "$new/plymouth" "$new/grub"
  ensure_module style-tui >&2
  # The login screen's own settings (who logs in, what starts) move with it
  if [[ -f $new/greeter/greeter.json ]]; then
    mkdir -p "$(module_dir style-tui)/greeter"
    mv "$new/greeter/greeter.json" "$(module_dir style-tui)/greeter/greeter.json"
  fi
  rm -rf "$new/greeter"
  # gtk lives in the style now; the bar and panels come with quickshell
  for f in "${pkgs[@]}"; do
    case $f in
      quickshell) echo quickshell; echo tui ;;
      *) echo "$f" ;;
    esac
  done
  ok "Moved: core and style-tui" >&2
}

# Clones a module the first time it is needed (shallow: only the newest version)
ensure_module() {
  local m=$1
  has_module "$m" && return 0
  run mkdir -p "$MODULES_DIR"
  task "Getting the $m module" "$m" git clone --depth 1 --quiet "$ORG_URL/$m.git" "$(module_dir "$m")" \
    || die "Could not download the $m module ($ORG_URL/$m)" "check the internet connection, then run the same command again"
}

PACKAGES=(ghostty fish starship fastfetch spicetify vencord steam quickshell tui bloom hypr wallpaper keyboard gtk zed dolphin zen)

# Distro packages each config needs; AUR ones go through paru/yay
declare -A DEPS=(
  [ghostty]="ghostty"
  [fish]="fish"
  [starship]="starship"
  [fastfetch]="fastfetch chafa"
  # curl, jq, openssl: frame-spotify, the Web API helper for the launcher
  [spicetify]="spicetify-cli ttf-jetbrains-mono curl jq openssl"
  [vencord]="vesktop ttf-jetbrains-mono jq git nodejs pnpm"
  # millennium (AUR) themes Steam and runs the plugin that sends its notifications to the shell;
  # python runs frame-steam-css, which recolors the library from Steam's own CSS
  [steam]="steam millennium ttf-jetbrains-mono jq python"
  # qt6-websockets: the Spotify bridge; grim: screenshots; wf-recorder: screen recordings; ffmpeg:
  # cutting screenshots out of the frozen screen and the editors' export (the emoji list, the
  # alarm sound, file search, clipboard history and the update check are the shell's own)
  [quickshell]="quickshell wl-clipboard libpulse pciutils qt6-websockets qt6-imageformats grim wf-recorder ffmpeg"
  # The tui style's fonts; noto-fonts-emoji: the launcher's emoji
  [tui]="ttf-jetbrains-mono ttf-nerd-fonts-symbols-mono noto-fonts-emoji"
  # The bloom style: Rubik for text (AUR), Material Symbols Rounded for the icons (extra);
  # JetBrains Mono for code and the CLI look, noto-fonts-emoji for the launcher's emoji
  [bloom]="ttf-rubik-vf ttf-material-symbols-variable ttf-jetbrains-mono noto-fonts-emoji"
  # Idle lock and screen off live in the shell (lockscreen/Lock.qml), no hypridle
  [hypr]=""
  # ffmpeg makes the video thumbnails in the wallpaper app; linux-wallpaperengine
  # comes on top when the "both" backend is picked
  [wallpaper]="jq mpvpaper ffmpeg"
  # frame-keyboard talks to the keyboards over hidraw with nothing but Python
  [keyboard]="python"
  # adw-gtk-theme (GTK 3 apps in the libadwaita look) is used when it is there, not required
  [gtk]="ttf-jetbrains-mono"
  [zed]="zed ttf-jetbrains-mono"
  # kio-extras: sftp:// and thumbnails; konsole and kdegraphics-thumbnailers are asked for
  # (OPTIONAL_DEPS below);
  # archlinux-xdg-menu: the "Open with" list outside Plasma
  [dolphin]="dolphin kio-extras ffmpegthumbs qt6ct archlinux-xdg-menu breeze-icons ttf-jetbrains-mono"
  [zen]="zen-browser-bin ttf-jetbrains-mono"
)

# Extras a package works without, asked for during install (default no, -y skips them):
# "package|what it gives you" entries, separated by ";"
declare -A OPTIONAL_DEPS=(
  [dolphin]="konsole|the terminal panel inside Dolphin (F4);kdegraphics-thumbnailers|previews of PDFs and RAW photos"
  [quickshell]="qt6-multimedia-ffmpeg|the recording editor (edit on a recording: cuts, pictures, blur, levels per channel)"
)

# App files outside the repo that frame touches or that belong in a backup
declare -A EXTRAS=(
  [fish]=".config/fish/config.fish"
  [spicetify]=".config/spicetify/config-xpui.ini"
  [vencord]=".config/vesktop/settings/settings.json"
  [steam]=".config/millennium/config.json"
  [hypr]=".config/hypr/hyprland.lua .config/hypr/hyprland.conf"
  [wallpaper]=".local/state/frameshell/wallpaper.json"
  [dolphin]=".config/dolphinrc .config/qt6ct/qt6ct.conf .config/kdeglobals"
)

DRY_RUN=0
ASSUME_YES=0
NO_PULL=0
VERBOSE=0
LAST_BACKUP=""
# Output of long commands (task) when they run behind a spinner
LOG_FILE="$STATE_DIR/frame.log"

# ── Output ───────────────────────────────────────────────────

# Color themes belong to a style: themes/<style>/<name>.json, and each style remembers its
# own (theme-<style> in the state folder), so switching styles brings back its colors
themes_dir() { echo "$REPO/themes/$(current_style)"; }
theme_state() { echo "$STATE_DIR/theme-$(current_style)"; }
default_theme() {
  case $(current_style) in
    bloom) [[ -f $(themes_dir)/nebula.json ]] && echo nebula || echo periwinkle ;;
    *) echo periwinkle ;;
  esac
}

# The active style's theme; tui falls back to the one picked before themes were per style
current_theme() {
  local t="" state
  state=$(theme_state)
  if [[ -f $state ]]; then
    t=$(<"$state")
  elif [[ $(current_style) == tui && -f $STATE_DIR/theme ]]; then
    t=$(<"$STATE_DIR/theme")
  fi
  [[ -n $t && -f $(themes_dir)/$t.json ]] || t=$(default_theme)
  echo "$t"
}

# theme_hex <theme> <role>: "5d6fe8" from the style's themes/<theme>.json, without needing jq
theme_hex() {
  sed -n "s/.*\"$2\": *\"#\([0-9a-fA-F]\{6\}\)\".*/\1/p" "$(themes_dir)/$1.json" 2>/dev/null | head -n 1
}

# 24-bit escape for a hex color: fg_hex 5d6fe8 (foreground) or bg_hex 5d6fe8 (background)
fg_hex() { printf '\e[38;2;%d;%d;%dm' "0x${1:0:2}" "0x${1:2:2}" "0x${1:4:2}"; }
bg_hex() { printf '\e[48;2;%d;%d;%dm' "0x${1:0:2}" "0x${1:2:2}" "0x${1:4:2}"; }

# Colors on a terminal, taken from the active theme; FORCE_COLOR keeps them in logs,
# NO_COLOR turns them off
USE_COLOR=0
if [[ -n ${FORCE_COLOR:-} || ( -t 1 && -z ${NO_COLOR:-} ) ]]; then
  USE_COLOR=1
  theme_now=$(current_theme)
  role() { local h; h=$(theme_hex "$theme_now" "$1"); fg_hex "${h:-$2}"; }
  c_text=$(role text e1e4ff)
  c_primary=$(role primary 5d6fe8)
  c_secondary=$(role secondary 93a4f7)
  c_muted=$(role muted 8086b8)
  c_ok=$(role ok 6ee0b6)
  c_warn=$(role warn f2c97d)
  c_danger=$(role danger ff6b9a)
  c_bold=$'\e[1m'
  c_reset=$'\e[0m'
  unset -f role
else
  c_text='' c_primary='' c_secondary='' c_muted='' c_ok='' c_warn='' c_danger='' c_bold='' c_reset=''
fi

# Once per run: the main menu shows it, the command picked there does not repeat it
HEADER_SHOWN=0
header() {
  ((HEADER_SHOWN)) && return 0
  HEADER_SHOWN=1
  printf '\n  %s%sfacet%s  %sCachyOS · Hyprland%s\n\n' \
    "$c_bold" "$c_primary" "$c_reset" "$c_muted" "$c_reset"
}

# Steps are numbered ([2/9] Dependencies) once a command has said how many there are
STEP_N=0
STEP_TOTAL=0
steps_total() { STEP_TOTAL=$1; }
step() {
  if ((STEP_N < STEP_TOTAL)); then
    STEP_N=$((STEP_N + 1))
    printf '\n%s[%d/%d]%s %s%s%s\n' "$c_primary" "$STEP_N" "$STEP_TOTAL" "$c_reset" "$c_bold" "$*" "$c_reset"
  else
    printf '\n%s●%s %s%s%s\n' "$c_primary" "$c_reset" "$c_bold" "$*" "$c_reset"
  fi
}
info() { printf '  %s%s%s\n' "$c_muted" "$*" "$c_reset"; }
ok()   { printf '  %s✓%s %s\n' "$c_ok" "$c_reset" "$*"; }
warn() { printf '  %s!%s %s\n' "$c_warn" "$c_reset" "$*"; }
# A next step for the user, under an error or a warning
hint() { printf '  %s→ %s%s\n' "$c_muted" "$*" "$c_reset"; }
# die <what went wrong> [what to do now]
die() {
  printf '%s✗%s %s\n' "$c_danger" "$c_reset" "$1" >&2
  [[ -z ${2:-} ]] || hint "$2" >&2
  exit 1
}

# Interactive: menus and checklists need a terminal on both ends
interactive() { [[ -t 0 && -t 2 ]]; }

# The command name a typo most likely meant, out of the candidates; nothing if none is close
closest() {
  local word=${1,,} best="" best_d=99 c
  shift
  for c in "$@"; do
    if ((${#word} >= 2)) && [[ $c == "$word"* ]]; then
      echo "$c"
      return 0
    fi
    edit_distance "$word" "$c"
    ((REPLY < best_d)) && best=$c best_d=$REPLY
  done
  ((best_d <= (${#word} > 4 ? 2 : 1))) && echo "$best"
  return 0
}

# Edit distance in REPLY; two swapped letters count as one edit ("stema" → steam)
edit_distance() {
  local a=$1 b=$2 n=${#1} m=${#2} i j cost v w=$((${#2} + 1))
  local -a d=()
  for ((i = 0; i <= n; i++)); do d[i*w]=$i; done
  for ((j = 0; j <= m; j++)); do d[j]=$j; done
  for ((i = 1; i <= n; i++)); do
    for ((j = 1; j <= m; j++)); do
      [[ ${a:i-1:1} == "${b:j-1:1}" ]] && cost=0 || cost=1
      v=$((d[(i - 1) * w + j] + 1))
      ((d[i * w + j - 1] + 1 < v)) && v=$((d[i * w + j - 1] + 1))
      ((d[(i - 1) * w + j - 1] + cost < v)) && v=$((d[(i - 1) * w + j - 1] + cost))
      if ((i > 1 && j > 1)) && [[ ${a:i-1:1} == "${b:j-2:1}" && ${a:i-2:1} == "${b:j-1:1}" ]]; then
        ((d[(i - 2) * w + j - 2] + 1 < v)) && v=$((d[(i - 2) * w + j - 2] + 1))
      fi
      d[i*w+j]=$v
    done
  done
  REPLY=${d[n * w + m]}
}

# "did you mean steam? " for a typo, else nothing; used in front of a list of the choices
did_you_mean() {
  local c
  c=$(closest "$@")
  [[ -z $c ]] || printf 'did you mean %s? ' "$c"
}

# Runs a command, or only prints it in dry-run mode
run() {
  if ((DRY_RUN)); then
    printf '  %swould run:%s %s\n' "$c_muted" "$c_reset" "$*"
    return 0
  fi
  "$@"
}

# Like run, but hides the command's own output
run_quiet() {
  if ((DRY_RUN)); then
    run "$@"
    return 0
  fi
  "$@" >/dev/null 2>&1
}

# m:ss since a $SECONDS value
elapsed() {
  local s=$((SECONDS - $1))
  printf '%d:%02d' $((s / 60)) $((s % 60))
}

# The first task of a run starts a section in the log; the log keeps only its newest
# 200 KB once it grows past 1 MB
LOG_STARTED=0
FACET_ARGS=""
log_start() {
  ((LOG_STARTED)) && return 0
  LOG_STARTED=1
  mkdir -p "$STATE_DIR"
  if [[ -f $LOG_FILE ]] && (($(wc -c <"$LOG_FILE") > 1048576)); then
    tail -c 204800 "$LOG_FILE" >"$LOG_FILE.tmp" && mv "$LOG_FILE.tmp" "$LOG_FILE"
  fi
  printf '\n── facet %s · %(%F %T)T ──\n' "$FACET_ARGS" -1 >>"$LOG_FILE"
}

# Spinner mode: a terminal to draw on and no -v
quiet_tasks() { ((!VERBOSE)) && [[ -t 2 && ${TERM:-dumb} != dumb ]]; }

# task <doing> <done> <command...>: a long command (download, package install, build).
# In a terminal a spinner and the time stay on one line while the output goes to
# $LOG_FILE; on failure the last lines of it and where the rest is. With -v, without a
# terminal the command runs like run, in a dry run it is only printed. <done> is printed
# on success (empty: nothing, the caller says it; never in a dry run, nothing was done).
task() {
  local doing=$1 done_msg=$2
  shift 2
  if ((DRY_RUN)); then
    run "$@"
    return 0
  fi
  if ! quiet_tasks; then
    info "$doing"
    "$@" || return
    [[ -z $done_msg ]] || ok "$done_msg"
    return 0
  fi
  # The command cannot ask for a password behind the spinner; sudo asks now, on screen
  case $1 in sudo | paru | yay) sudo -v || return 1 ;; esac
  log_start
  printf '\n[%(%T)T] %s\n$ %s\n' -1 "$doing" "$*" >>"$LOG_FILE"
  local from pid rc=0 start=$SECONDS i=0 line
  local frames=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
  from=$(($(wc -c <"$LOG_FILE") + 1))
  "$@" >>"$LOG_FILE" 2>&1 </dev/null &
  pid=$!
  printf '\e[?25l' >&2
  trap 'kill "$pid" 2>/dev/null; printf "\r\e[K\e[?25h" >&2; exit 130' INT
  while kill -0 "$pid" 2>/dev/null; do
    printf '\r\e[K  %s%s%s %s %s%s%s' "$c_primary" "${frames[i++ % 10]}" "$c_reset" \
      "$doing" "$c_muted" "$(elapsed "$start")" "$c_reset" >&2
    sleep 0.1
  done
  wait "$pid" || rc=$?
  trap - INT
  printf '\r\e[K\e[?25h' >&2
  if ((rc == 0)); then
    [[ -z $done_msg ]] || printf '  %s✓%s %s %s%s%s\n' "$c_ok" "$c_reset" "$done_msg" "$c_muted" "$(elapsed "$start")" "$c_reset"
    return 0
  fi
  printf '  %s✗%s %s failed %s%s%s\n' "$c_danger" "$c_reset" "$doing" "$c_muted" "$(elapsed "$start")" "$c_reset"
  tail -c +"$from" "$LOG_FILE" | grep -v '^[[:space:]]*$' | tail -n 12 | while IFS= read -r line; do
    printf '  %s│ %s%s\n' "$c_muted" "$line" "$c_reset"
  done || true
  hint "full log: ${LOG_FILE/#"$HOME"/\~} · all output on screen: the same command with -v"
  return "$rc"
}

# checklist <question> <preselected ids> <id|description>...: prints the picked ids, one per
# line. In a terminal: ↑↓ move, space toggles, a toggles all, enter takes the ticked ones,
# esc cancels (exit code 1). Drawn on stderr like menu. Without a terminal: a numbered
# list answered with numbers ("1 3"), all or none; enter keeps the preselection, and so
# does -y.
checklist() {
  local question=$1 preset=" $2 "
  shift 2
  local opts=("$@") n=$# i id desc key rest sel=0 drawn=0 picked mark answer
  local -a on=()
  for ((i = 0; i < n; i++)); do
    [[ $preset == *" ${opts[i]%%|*} "* ]] && on[i]=1 || on[i]=0
  done

  if ((!ASSUME_YES)) && interactive; then
    printf '  %s\n' "$question" >&2
    printf '  %s↑↓ move · space tick · a all · enter done · esc cancel%s\n' "$c_muted" "$c_reset" >&2
    printf '\e[?25l' >&2
    trap 'printf "\e[?25h\n" >&2; exit 130' INT
    while :; do
      # n options and the count below them
      ((drawn)) && printf '\e[%dA' $((n + 1)) >&2
      drawn=1
      picked=0
      for ((i = 0; i < n; i++)); do
        id=${opts[i]%%|*}
        desc=${opts[i]#*|}
        ((on[i])) && picked=$((picked + 1))
        ((on[i])) && mark="$c_primary[■]$c_reset" || mark="$c_muted[ ]$c_reset"
        if ((i == sel)); then
          printf '\r\e[K  %s❯%s %s %s%-11s%s %s\n' "$c_primary" "$c_reset" "$mark" "$c_bold" "$id" "$c_reset" "$desc" >&2
        elif ((on[i])); then
          printf '\r\e[K    %s %-11s %s\n' "$mark" "$id" "$desc" >&2
        else
          printf '\r\e[K    %s %s%-11s%s %s\n' "$mark" "$c_muted" "$id" "$c_reset" "$desc" >&2
        fi
      done
      printf '\r\e[K  %s%d of %d ticked%s\n' "$c_muted" "$picked" "$n" "$c_reset" >&2
      IFS= read -rsn1 key || key=$'\e'
      case $key in
        "") break ;;
        " ") on[sel]=$((1 - on[sel])) ;;
        a | A)
          # All on, or all off when they already are
          mark=0
          for ((i = 0; i < n; i++)); do ((on[i])) || mark=1; done
          for ((i = 0; i < n; i++)); do on[i]=$mark; done
          ;;
        k) sel=$(((sel - 1 + n) % n)) ;;
        j) sel=$(((sel + 1) % n)) ;;
        $'\e')
          rest=""
          IFS= read -rsn2 -t 0.05 rest || true
          case $rest in
            "[A") sel=$(((sel - 1 + n) % n)) ;;
            "[B") sel=$(((sel + 1) % n)) ;;
            "")
              trap - INT
              printf '\e[?25h' >&2
              return 1
              ;;
          esac
          ;;
      esac
    done
    trap - INT
    printf '\e[?25h' >&2
  elif ((!ASSUME_YES)); then
    printf '  %s\n' "$question" >&2
    for ((i = 0; i < n; i++)); do
      ((on[i])) && mark="[x]" || mark="[ ]"
      printf '    %s%d%s %s %-11s %s%s%s\n' "$c_primary" $((i + 1)) "$c_reset" "$mark" "${opts[i]%%|*}" "$c_muted" "${opts[i]#*|}" "$c_reset" >&2
    done
    printf '  Numbers (e.g. 1 3), all or none [enter: as ticked] ' >&2
    answer=""
    read -r answer || true
    [[ -t 0 ]] || printf '%s\n' "$answer" >&2
    case ${answer,,} in
      "") ;;
      all) for ((i = 0; i < n; i++)); do on[i]=1; done ;;
      none) for ((i = 0; i < n; i++)); do on[i]=0; done ;;
      *)
        for ((i = 0; i < n; i++)); do on[i]=0; done
        for i in ${answer//,/ }; do
          [[ $i =~ ^[0-9]+$ ]] && ((i >= 1 && i <= n)) && on[i - 1]=1
        done
        ;;
    esac
  fi
  for ((i = 0; i < n; i++)); do
    ((on[i])) && echo "${opts[i]%%|*}"
  done
  return 0
}

# Like confirm, but no unless the answer is yes; -y counts as no (nothing extra unasked)
confirm_extra() {
  ((ASSUME_YES)) && return 1
  local answer=""
  printf '  %s [y/N] ' "$1"
  read -r answer || true
  [[ -t 0 ]] || printf '%s\n' "${answer:-n}"
  [[ $answer =~ ^[YyJj] ]]
}

# The optional extras of these packages that the user wants and that are not there yet
optional_deps_of() {
  local p entry pkg
  for p in "$@"; do
    [[ -n ${OPTIONAL_DEPS[$p]:-} ]] || continue
    # The list on fd 3, so the question still reads its answer from the terminal
    while IFS= read -r -d ';' -u 3 entry || [[ -n $entry ]]; do
      entry=${entry%$'\n'}
      pkg=${entry%%|*}
      has_pkg "$pkg" && continue
      confirm_extra "$p: also ${entry#*|} ($pkg)?" >&2 && echo "$pkg"
    done 3<<<"${OPTIONAL_DEPS[$p]}"
  done
  return 0
}

confirm() {
  ((ASSUME_YES)) && return 0
  local answer=""
  printf '  %s [Y/n] ' "$1"
  read -r answer || true
  # Typed answers are already on screen; piped ones are echoed so logs read right
  [[ -t 0 ]] || printf '%s\n' "${answer:-y}"
  [[ -z $answer || $answer =~ ^[YyJj] ]]
}

# choose <question> <key|description>...: prints the picked key; the first is the default.
# The menu goes to stderr, so the answer can be captured with $(…).
# Arrow-key menu for a terminal: ↑↓ move, Enter takes it, typing jumps to the option that
# starts with what was typed ("sa" → sakura), a digit takes that option, Esc cancels
# (exit code 1, nothing printed). Options are "id|description"; the menu is drawn on
# stderr so the answer can be captured: id=$(menu "Question?" <start index> "${opts[@]}")
# With MENU_PREVIEW set (id → lines, MENU_PREVIEW_LINES of them), the highlighted option's
# preview is drawn under the list, as facet theme set does with each theme's colors.
declare -A MENU_PREVIEW=()
MENU_PREVIEW_LINES=0
menu() {
  local question=$1 sel=${2:-0}
  shift 2
  local opts=("$@") n=$# i id desc key rest attempt typed="" drawn=0 pv=0
  # Only when the previews are for these options (they stay set after the theme menu)
  [[ -n ${MENU_PREVIEW[${1%%|*}]:-} ]] && pv=$MENU_PREVIEW_LINES
  ((sel >= 0 && sel < n)) || sel=0
  printf '  %s\n' "$question" >&2
  printf '  %s↑↓ move · enter pick · type to jump · esc cancel%s\n' "$c_muted" "$c_reset" >&2
  printf '\e[?25l' >&2
  # The cursor has to come back even on Ctrl+C
  trap 'printf "\e[?25h\n" >&2; exit 130' INT
  while :; do
    ((drawn)) && printf '\e[%dA' $((n + pv)) >&2
    drawn=1
    for ((i = 0; i < n; i++)); do
      id=${opts[i]%%|*}
      desc=${opts[i]#*|}
      if ((i == sel)); then
        printf '\r\e[K  %s❯%s %s%-11s%s %s\n' "$c_primary" "$c_reset" "$c_bold" "$id" "$c_reset" "$desc" >&2
      else
        printf '\r\e[K    %s%-11s%s %s\n' "$c_muted" "$id" "$c_reset" "$desc" >&2
      fi
    done
    ((pv)) && printf '%s' "${MENU_PREVIEW[${opts[sel]%%|*}]:-}" >&2
    IFS= read -rsn1 key || key=$'\e'
    case $key in
      "") break ;;
      $'\e')
        rest=""
        IFS= read -rsn2 -t 0.05 rest || true
        case $rest in
          "[A") sel=$(((sel - 1 + n) % n)); typed="" ;;
          "[B") sel=$(((sel + 1) % n)); typed="" ;;
          "")
            trap - INT
            printf '\e[?25h' >&2
            return 1
            ;;
        esac
        ;;
      [1-9])
        if ((key <= n)); then
          sel=$((key - 1))
          break
        fi
        ;;
      *)
        # Type-ahead: the longest typed prefix that still matches, else start again
        typed+=${key,,}
        for attempt in "$typed" "${key,,}"; do
          for ((i = 0; i < n; i++)); do
            id=${opts[i]%%|*}
            if [[ ${id,,} == "$attempt"* ]]; then
              sel=$i
              typed=$attempt
              continue 3
            fi
          done
        done
        typed=""
        ;;
    esac
  done
  trap - INT
  printf '\e[?25h' >&2
  echo "${opts[sel]%%|*}"
}

choose() {
  local question=$1 answer="" i=1 opt
  shift
  local opts=("$@")
  if ((ASSUME_YES)); then
    echo "${opts[0]%%|*}"
    return 0
  fi
  # In a terminal: the arrow-key menu; Esc there means the first option, like Enter on
  # the numbered prompt below (piped input, logs)
  if [[ -t 0 && -t 2 ]]; then
    menu "$question" 0 "${opts[@]}" || echo "${opts[0]%%|*}"
    return 0
  fi
  printf '  %s\n' "$question" >&2
  for opt in "${opts[@]}"; do
    printf '    %s%d%s %-11s %s%s%s\n' "$c_primary" "$i" "$c_reset" "${opt%%|*}" "$c_muted" "${opt#*|}" "$c_reset" >&2
    i=$((i + 1))
  done
  printf '  Pick 1-%d [1] ' "${#opts[@]}" >&2
  read -r answer || true
  [[ -t 0 ]] || printf '%s\n' "${answer:-1}" >&2
  [[ $answer =~ ^[0-9]+$ ]] && ((answer >= 1 && answer <= ${#opts[@]})) || answer=1
  echo "${opts[answer - 1]%%|*}"
}

# Every command, for the help, the main menu's checks and "did you mean"
COMMANDS=(install add update remove backup restore theme style grub boot goxlr audio keyboard login wallpaper spotify layout status clean help)

usage() {
  header
  local s=$c_secondary r=$c_reset m=$c_muted b=$c_bold
  cat <<EOF
  ${b}Usage${r}  facet [command] [module...] [options]   ${m}(no command: a menu)${r}

  ${b}Getting started${r}
    ${s}install${r} [module...]       the setup (no names), or just these modules
    ${s}add${r} [module...]           fetch and set up a module later (no names: pick from a list)
    ${m}e.g. facet add steam${r}

  ${b}Everyday${r}
    ${s}update${r} [module...]        pull the CLI and the modules, back up, relink, re-apply themes
                              (run "facet update spotify" after a Spotify update)
    ${s}theme${r}                     write every app color file from the active theme
    ${s}theme set${r} [name]          switch every app to another theme (no name: pick one)
    ${s}theme list${r} · ${s}check${r}        the themes, or only report files that are out of date
    ${s}style${r} [name|list]       the look of the desktop: tui or bloom (theme is its colors)
    ${s}layout${r} [tiling|canvas]    normal tiling or the infinite canvas
    ${s}status${r}                    what is linked and what is missing
    ${m}e.g. facet theme set sakura${r}

  ${b}Apps${r}
    ${s}spotify${r} login|status      connect the Spotify Web API for the launcher; logout forgets it
    ${s}wallpaper${r} <…>             wallpaper backends: both, mpv, image (facet wallpaper help)
    ${s}goxlr${r}                     GoXLR faders, buttons and animation in the theme's colors
    ${s}audio channels${r} on|off     virtual System, Game, Chat, Music outputs without a GoXLR
                              (on [names] [--output <sink>], output <sink>, status)
    ${s}keyboard${r} [list|set]       the supported keyboards, which one is yours (no name: pick)
                              (search <text>; request: how to ask for another one)
    ${m}e.g. facet wallpaper backend mpv${r}

  ${b}System${r}
    ${s}login${r} [install|remove]    the lockscreen look as the login screen (greetd, sudo)
    ${s}login auto${r}                no greeter at boot, the shell's lockscreen asks instead
    ${s}boot${r} [check|remove]       boot splash (Plymouth) and console colors (sudo)
    ${s}grub${r} [install|remove]     theme the GRUB boot menu (copies to /boot, sudo)
    ${s}backup${r} [pkg...]           snapshot the current configs and app settings
    ${s}restore${r} [name|latest]     list backups, or put one back
    ${s}remove${r} [module...]        unlink a module and delete it (dependencies stay)
    ${s}clean${r}                     free disk space: caches, orphans, old backups, logs
    ${m}e.g. facet restore latest${r}

  ${b}Options${r}
    -n, --dry-run             print what would happen, change nothing
    -y, --yes                 do not ask, take the defaults
    -v, --verbose             show everything long commands print (otherwise: a spinner,
                              the output in ${LOG_FILE/#"$HOME"/\~})

  ${b}Modules${r}   ${MODULES[*]}
  ${b}Packages${r}  ${PACKAGES[*]}
  ${b}Themes${r}    $(theme_ids | tr '\n' ' ')

EOF
}

# frame without a command, in a terminal: the everyday commands with the current state
# next to them; sets MENU_CMD and MENU_ARGS for main
main_menu() {
  header
  local pick start=0 opts
  # Nothing there yet: install; otherwise the usual update
  [[ -n $(installed_modules) ]] && start=2
  opts=(
    "install|set up facet, or more modules"
    "add|add apps: Spotify, Vesktop, Steam, Zed, Dolphin, Zen"
    "update|pull, back up, relink, re-apply the theme"
    "theme|switch the colors (now: $(current_theme))"
    "style|switch the look of the desktop (now: $(current_style))"
    "layout|tiling or the infinite canvas (now: $(current_layout))"
    "remove|unlink and delete modules"
    "status|what is linked and what is missing"
    "clean|free disk space"
    "help|all commands"
  )
  pick=$(menu "What do you want to do?" "$start" "${opts[@]}") || exit 0
  MENU_ARGS=()
  case $pick in
    theme) MENU_ARGS=(set) ;;
    style) MENU_ARGS=(set) ;;
    layout)
      local now
      now=$(current_layout)
      pick=$(menu "Which layout? (now: $now)" "$([[ $now == canvas ]] && echo 1 || echo 0)" \
        "tiling|Hyprland's tiling with workspaces" \
        "canvas|windows float on an endless plane, the bar shows a minimap") || exit 0
      MENU_ARGS=("$pick")
      pick=layout
      ;;
  esac
  MENU_CMD=$pick
}

# ── Helpers ──────────────────────────────────────────────────

is_package() {
  local p
  for p in "${PACKAGES[@]}"; do [[ $p == "$1" ]] && return 0; done
  return 1
}

# sudo works without asking (cached, NOPASSWD) or there is a terminal it can ask on
sudo_possible() {
  sudo -n true 2>/dev/null || (exec </dev/tty) 2>/dev/null
}

need_arch() {
  command -v pacman >/dev/null \
    || die "pacman not found: facet needs an Arch-based system" "facet runs on CachyOS (or Arch) with Hyprland"
}

has_pkg() {
  command -v pacman >/dev/null && pacman -Qq "$1" &>/dev/null
}

aur_helper() {
  local h
  for h in paru yay; do
    command -v "$h" >/dev/null && { echo "$h"; return 0; }
  done
  return 0
}

deps_of() {
  local p d
  for p in "$@"; do
    for d in ${DEPS[$p]}; do echo "$d"; done
  done
}

install_deps() {
  local missing=() p helper
  # Several packages need the same fonts; ask for each package once
  for p in "$@"; do
    [[ " ${missing[*]} " == *" $p "* ]] && continue
    has_pkg "$p" || missing+=("$p")
  done
  if ((${#missing[@]} == 0)); then
    ok "All dependencies already installed"
    return 0
  fi
  info "Missing: ${missing[*]}"

  local flags=() cmd=()
  ((ASSUME_YES)) && flags=(--noconfirm)
  helper="$(aur_helper)"
  # Behind the spinner nobody can answer: the list was confirmed already, so the defaults
  # are taken; --sudoloop keeps sudo alive through long AUR builds
  if quiet_tasks && ((!DRY_RUN)); then
    flags=(--noconfirm)
    [[ -n $helper ]] && flags+=(--sudoloop)
    [[ $helper == paru ]] && flags+=(--skipreview)
  fi
  if [[ -n $helper ]]; then
    cmd=("$helper" -S --needed "${flags[@]}" "${missing[@]}")
  else
    warn "No AUR helper (paru/yay) found, AUR packages like spicetify-cli will fail"
    cmd=(sudo pacman -S --needed "${flags[@]}" "${missing[@]}")
  fi
  local count=${#missing[@]} with=${helper:-pacman}
  task "Installing $count packages with $with" "$count packages installed" "${cmd[@]}" \
    || die "Installing the packages failed" "run the command again with -v to see what $with asks or reports"
}

# Zen's default profile folder, from profiles.ini: the [Install…] entry wins, then the
# profile marked Default=1, then the first one. Prints nothing before Zen's first start.
zen_profile() {
  local dir ini path
  for dir in "$HOME/.zen" "${XDG_CONFIG_HOME:-$HOME/.config}/zen"; do
    ini="$dir/profiles.ini"
    [[ -f $ini ]] || continue
    path=$(awk -F= '
      /^\[/ { install = ($0 ~ /^\[Install/); profile = ($0 ~ /^\[Profile/); marked = 0; last = ""; next }
      install && $1 == "Default" && !inst { inst = substr($0, 9) }
      profile && $1 == "Path" { p = substr($0, 6); if (!first) first = p; last = p }
      profile && $1 == "Default" && $2 == "1" { marked = 1 }
      profile && marked && last != "" && !def { def = last }
      END { print (inst != "" ? inst : (def != "" ? def : first)) }
    ' "$ini")
    [[ -n $path ]] || continue
    [[ $path == /* ]] || path="$dir/$path"
    [[ -d $path ]] && { echo "$path"; return 0; }
  done
  return 0
}

# Where a package is linked to: $HOME, except Zen, whose files go into its profile.
# Prints nothing if that folder does not exist yet.
pkg_root() {
  case $1 in
    zen) zen_profile ;;
    *) echo "$HOME" ;;
  esac
}

# Files of a package, relative to the package root
pkg_files() {
  [[ -d $(pkg_dir "$1") ]] || return 0
  (cd "$(pkg_dir "$1")" && find . \( -type f -o -type l \) | sed 's|^\./||' | sort)
}

# Repo files plus the app files listed in EXTRAS, relative to $HOME (for backups)
managed_files() {
  local root prefix="" f extra
  root="$(pkg_root "$1")"
  [[ -n $root ]] || return 0
  [[ $root == "$HOME" ]] || prefix="${root#"$HOME"/}/"
  while IFS= read -r f; do echo "$prefix$f"; done < <(pkg_files "$1")
  for extra in ${EXTRAS[$1]:-}; do echo "$extra"; done
}

# Prints linked, partial or missing
link_state() {
  local pkg=$1 f root total=0 linked=0 dir
  root="$(pkg_root "$pkg")"
  [[ -n $root ]] || { echo missing; return 0; }
  dir=$(readlink -f "$(pkg_dir "$pkg")" 2>/dev/null || pkg_dir "$pkg")
  while IFS= read -r f; do
    total=$((total + 1))
    if [[ -L $root/$f && "$(readlink -f "$root/$f")" == "$dir/$f" ]]; then
      linked=$((linked + 1))
    fi
  done < <(pkg_files "$pkg")
  if ((total > 0 && linked == total)); then echo linked
  elif ((linked > 0)); then echo partial
  else echo missing
  fi
}

installed_packages() {
  local p
  for p in "${PACKAGES[@]}"; do
    [[ $(link_state "$p") == missing ]] || echo "$p"
  done
}

new_backup_dir() {
  echo "$BACKUP_ROOT/$(date +%Y%m%d-%H%M%S)-$1"
}

# Copies files (relative to $HOME, symlinks resolved) into a new backup
snapshot_files() {
  local reason=$1 f n=0
  shift
  LAST_BACKUP="$(new_backup_dir "$reason")"
  for f in "$@"; do
    [[ -e $HOME/$f ]] || continue
    run mkdir -p "$LAST_BACKUP/$(dirname "$f")"
    run cp -L "$HOME/$f" "$LAST_BACKUP/$f"
    n=$((n + 1))
  done
  if ((n)); then ok "Backup $(basename "$LAST_BACKUP") ($n files)"; else info "Nothing to back up"; fi
}

snapshot_pkgs() {
  local reason=$1 p f files=()
  shift
  for p in "$@"; do
    while IFS= read -r f; do files+=("$f"); done < <(managed_files "$p")
  done
  snapshot_files "$reason" "${files[@]}"
}

# Moves existing files that would block stow into the backup folder
backup_conflicts() {
  local pkg=$1 dest=$2 f target root dir
  root="$(pkg_root "$pkg")"
  dir=$(readlink -f "$(pkg_dir "$pkg")" 2>/dev/null || pkg_dir "$pkg")
  while IFS= read -r f; do
    target="$root/$f"
    [[ -e $target || -L $target ]] || continue
    [[ "$(readlink -f "$target")" == "$dir/$f" ]] && continue
    warn "Backing up existing ~/$f"
    run mkdir -p "$dest/$(dirname "$f")"
    run mv "$target" "$dest/$f"
  done < <(pkg_files "$pkg")
}

# stow_pkg <-R|-D> <package>; --no-folding links single files, so apps never write into the repo
stow_pkg() {
  local root
  root="$(pkg_root "$2")"
  run stow --no-folding -d "$(module_dir "${MODULE_OF[$2]}")" -t "$root" "$1" "$2"
}

# Backs up whatever is in the way, then links the package; skips packages whose
# target folder does not exist yet (Zen before its first start)
link_pkg() {
  local pkg=$1 backup=$2
  if [[ -z $(pkg_root "$pkg") ]]; then
    warn "Nothing to link into yet"
    return 0
  fi
  backup_conflicts "$pkg" "$backup"
  stow_pkg -R "$pkg"
  ok "Config linked"
}

# Backup folder names, newest first
list_backups() {
  [[ -d $BACKUP_ROOT ]] || return 0
  find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort -r
}

link_self() {
  local bin="$HOME/.local/bin/facet" old="$HOME/.local/bin/frame"
  if [[ "$(readlink -f "$bin" 2>/dev/null)" != "$REPO/facet" ]]; then
    run mkdir -p "$HOME/.local/bin"
    run ln -sf "$REPO/facet" "$bin"
    ok "facet is now available as a command (~/.local/bin/facet)"
  fi
  # The command was called frame before; its link pointed into this repo
  if [[ -L $old && "$(readlink "$old")" == "$REPO/"* ]]; then
    run rm -f "$old"
    info "The old frame command is gone, it is facet now"
  fi
  link_completions
}

# Tab completion for fish and bash (completions/); both ask `facet __complete` for the lists
link_completions() {
  local fish_dir="${XDG_CONFIG_HOME:-$HOME/.config}/fish/completions"
  local bash_dir="${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion/completions"
  local linked=0
  if [[ "$(readlink -f "$fish_dir/facet.fish" 2>/dev/null)" != "$REPO/completions/facet.fish" ]]; then
    run mkdir -p "$fish_dir"
    run ln -sf "$REPO/completions/facet.fish" "$fish_dir/facet.fish"
    linked=1
  fi
  if [[ "$(readlink -f "$bash_dir/facet" 2>/dev/null)" != "$REPO/completions/facet.bash" ]]; then
    run mkdir -p "$bash_dir"
    run ln -sf "$REPO/completions/facet.bash" "$bash_dir/facet"
    linked=1
  fi
  ((linked)) && ok "Tab completion for facet in fish and bash (new shells)"
  # The ones for the old frame command point at files that are gone
  local old
  for old in "$fish_dir/frame.fish" "$bash_dir/frame"; do
    [[ -L $old && ! -e $old ]] && run rm -f "$old"
  done
  return 0
}

# Lists for the completions: facet __complete commands|packages|installed|themes|backups
cmd_complete() {
  case ${1:-} in
    commands) printf '%s\n' "${COMMANDS[@]}" ;;
    modules) printf '%s\n' "${MODULES[@]}" ;;
    packages) printf '%s\n' "${PACKAGES[@]}" ;;
    installed) installed_packages ;;
    themes) theme_ids ;;
    styles) style_names ;;
    backups) list_backups ;;
    keyboards) [[ -d $(keyboard_boards_dir) ]] && find "$(keyboard_boards_dir)" -name '*.json' -printf '%f\n' | sed 's/\.json$//' | sort ;;
    # Real outputs for facet audio channels output
    sinks) command -v pactl >/dev/null && { pactl list short sinks 2>/dev/null | awk '$2 !~ /^facet-/ && $2 != "frame-rec" { print $2 }'; } ;;
  esac
  return 0
}

run_post() {
  if declare -F "post_$1" >/dev/null; then "post_$1"; fi
}

