  if confirm "Open folders with Dolphin?"; then
    set_default_app org.kde.dolphin.desktop inode/directory       && ok "Dolphin is the default file manager"
  fi
  info "SFTP: type sftp://user@host into the address bar; Places → right click → Add Entry keeps it"
  info "Log out and in once so Hyprland sets QT_QPA_PLATFORMTHEME for the new look"
}

# Zen's files go into its profile folder, which exists after the first start
post_zen() {
  local profile
  profile="$(zen_profile)"
  if [[ -z $profile ]]; then
    info "Start Zen once and close it, then run: facet install zen"
    return 0
  fi
  info "Profile: ${profile/#"$HOME"/\~}"
  # The start page lives at a fixed place, so the home page pref does not depend on the profile
  local page="${XDG_DATA_HOME:-$HOME/.local/share}/frameshell/startpage.html"
  if [[ "$(readlink -f "$page" 2>/dev/null)" != "$(pkg_dir zen)/startpage.html" ]]; then
    run mkdir -p "$(dirname "$page")"
    run ln -sf "$(pkg_dir zen)/startpage.html" "$page"
    ok "Start page: ${page/#"$HOME"/\~} (Zen's home page)"
  fi
  if command -v pgrep >/dev/null && pgrep -x zen-bin >/dev/null; then
    info "Zen is running; restart it to load the theme"
  fi
  if confirm "Make Zen the default browser?"; then
    if command -v xdg-settings >/dev/null || ((DRY_RUN)); then
      # xdg-settings refuses while $BROWSER is set; that is a warning, not a reason to stop the update
      if run xdg-settings set default-web-browser zen.desktop; then
        ok "Zen is the default browser"
      elif [[ ${BROWSER:-} == *zen* ]]; then
        ok "Zen is the default browser (\$BROWSER=$BROWSER)"
      elif [[ -n ${BROWSER:-} ]]; then
        warn "\$BROWSER is set ($BROWSER), so xdg-settings leaves the default browser alone; set BROWSER=zen-browser there instead"
      else
        warn "xdg-settings could not make Zen the default browser"
      fi
    else
      warn "xdg-settings not found (xdg-utils)"
    fi
  fi
  return 0
}

# Asks for the wallpaper backend once; later changes go through: facet wallpaper backend …
post_wallpaper() {
  local bin="$HOME/.local/bin/frame-wallpaper" state="$STATE_DIR/wallpaper.json" backend
  if [[ -f $state ]] && command -v jq >/dev/null; then
    backend="$(jq -r '.backend // "both"' "$state")"
    ok "Wallpaper backend: $backend"
  else
    backend="$(choose "Which wallpapers should run?" \
      "both|Wallpaper Engine scenes from the Steam Workshop, plus videos and images" \
      "mpv|only your own videos and images (mpvpaper, swaybg)" \
      "image|only still images, lowest power use")"
  fi
  if [[ $backend == both ]] && ! command -v linux-wallpaperengine >/dev/null; then
    info "Wallpaper Engine scenes need linux-wallpaperengine (AUR) and Wallpaper Engine bought on Steam"
    install_deps linux-wallpaperengine-git
  fi
  if ((DRY_RUN)); then
    info "would run: frame-wallpaper backend $backend"
  elif [[ -x $bin ]]; then
    if "$bin" backend "$backend" >/dev/null; then
      ok "Backend set to $backend"
    else
